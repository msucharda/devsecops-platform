#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
while read -r local_ref local_oid remote_ref remote_oid
do
    # Deleting a ref does not publish source content.
    case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
    head=$(git rev-parse --verify "$local_oid^{commit}")
    pwsh -NoProfile -NonInteractive -File "$root/tools/Test-LocalCiResult.ps1" -ExpectedHead "$head"
done
