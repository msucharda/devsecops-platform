# security-check: setup-app-permission
function Test-SetupAppPermission {
    [CmdletBinding()]
    [OutputType([bool])]
    param(
        [AllowNull()][System.Collections.IDictionary] $Actual,
        [Parameter(Mandatory)][System.Collections.IDictionary] $Expected
    )

    if ($null -eq $Actual) { return $false }
    $normalized = @{}
    foreach ($permissionName in $Actual.Keys) {
        if ($permissionName -eq 'metadata' -and $Actual[$permissionName] -eq 'read' -and -not $Expected.Contains('metadata')) { continue }
        $normalized[[string] $permissionName] = [string] $Actual[$permissionName]
    }
    if ($normalized.Count -ne $Expected.Count) { return $false }
    foreach ($permissionName in $Expected.Keys) {
        if ($normalized[$permissionName] -cne $Expected[$permissionName]) { return $false }
    }
    return $true
}

function ConvertTo-SetupBase64Url {
    [CmdletBinding()]
    [OutputType([string])]
    param([Parameter(Mandatory)][byte[]] $Bytes)

    return [Convert]::ToBase64String($Bytes).TrimEnd('=').Replace('+', '-').Replace('/', '_')
}

function ConvertTo-SetupAppJwt {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)][string] $AppId,
        [Parameter(Mandatory)][string] $KeyPath
    )

    $now = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds()
    $header = ConvertTo-SetupBase64Url -Bytes ([System.Text.Encoding]::UTF8.GetBytes('{"alg":"RS256","typ":"JWT"}'))
    $claims = ConvertTo-Json -InputObject ([ordered]@{ iat = $now - 60; exp = $now + 540; iss = $AppId }) -Compress
    $payload = ConvertTo-SetupBase64Url -Bytes ([System.Text.Encoding]::UTF8.GetBytes($claims))
    $rsa = [System.Security.Cryptography.RSA]::Create()
    try {
        $rsa.ImportFromPem((Get-Content -LiteralPath $KeyPath -Raw))
        $signature = $rsa.SignData([System.Text.Encoding]::UTF8.GetBytes("$header.$payload"),
            [System.Security.Cryptography.HashAlgorithmName]::SHA256, [System.Security.Cryptography.RSASignaturePadding]::Pkcs1)
    }
    finally {
        $rsa.Dispose()
    }
    return "$header.$payload.$(ConvertTo-SetupBase64Url -Bytes $signature)"
}

function Find-SetupAppKey {
    [CmdletBinding()]
    [OutputType([hashtable])]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string] $Role,
        [Parameter(Mandatory)][string] $AppId
    )

    $target = Join-Path $Setup.WorkPath "keys/probe-$Role.pem"
    $downloads = Join-Path $HOME 'Downloads'
    $candidates = [System.Collections.Generic.List[string]]::new()
    if (Test-Path -LiteralPath $target) { $candidates.Add($target) }
    if (Test-Path -LiteralPath $downloads) {
        $recent = (Get-Date).AddDays(-1)
        Get-ChildItem -LiteralPath $downloads -Filter '*.private-key.pem' -File |
            Where-Object { $_.LastWriteTime -gt $recent } | Sort-Object -Property LastWriteTime -Descending |
            ForEach-Object { $candidates.Add($_.FullName) }
    }
    foreach ($candidate in $candidates) {
        try {
            $jwt = ConvertTo-SetupAppJwt -AppId $AppId -KeyPath $candidate
        }
        catch {
            Write-Verbose -Message "Skipping '$candidate': $($_.Exception.Message)"
            continue
        }
        $response = Invoke-SetupApi -Setup $Setup -Uri "https://api.$($Setup.Settings['githubHost'])/app" -Token $jwt
        if ($response.Status -ne 'Ok' -or $response.Data -isnot [System.Collections.IDictionary] -or [string] $response.Data['id'] -ne $AppId) { continue }
        if ($candidate -ne $target) {
            Move-Item -LiteralPath $candidate -Destination $target -Force
            Show-SetupMessage -Message "Moved the private key of App $AppId to $target."
        }
        return @{ KeyPath = $target; App = $response.Data }
    }
    Exit-SetupStage -Status Missing -Message "No private key of App $AppId was found." -Guidance @(
        'App settings > General > Private keys > Generate a private key. The browser saves <app>.<date>.private-key.pem to Downloads.',
        "The wizard checks $target and keys downloaded in the last 24 hours. Then choose [r]."
    )
}

function Get-SetupProbeApp {
    [CmdletBinding()]
    [OutputType([hashtable])]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][ValidatePattern('^[a-z][a-z0-9-]*$')][string] $Role,
        [Parameter(Mandatory)][System.Collections.IDictionary] $Permission,
        [Parameter(Mandatory)][ValidateSet('selected', 'all', 'none')][string] $Selection,
        [string] $Organization,
        [string] $AppName,
        [System.Collections.IDictionary] $RegistrationState
    )

    $probe = if ($null -ne $RegistrationState) { $RegistrationState } else { $Setup.State.probe }
    $githubHost = $Setup.Settings['githubHost']
    $enterprise = $Setup.Settings['enterprise']
    $api = "https://api.$githubHost"
    $org = if ($Organization) { $Organization } else { $probe['organization'] }
    if (-not $AppName) { $AppName = "$($Setup.Settings['name'])-probe-$Role" }
    $appsUrl = "https://$githubHost/enterprises/$enterprise/settings/apps"
    $appIdKey = "$($Role)AppId"
    if (-not $probe[$appIdKey]) {
        $lookup = Invoke-SetupApi -Setup $Setup -Uri "$api/apps/$appName"
        if ($lookup.Status -ne 'Ok') {
            Show-SetupMessage -Kind Warning -Message "OAuth lookup of $appName did not succeed. $($lookup.Message)"
            Show-SetupGuidance -Line @(
                "Private enterprise Apps can return HTTP 404 even when registered. Check $appsUrl before creating another App.",
                'An App ID entered below is verified with its private key through GET /app; it is not accepted on trust.'
            )
            if (-not (Confirm-SetupAction -Prompt "Is $appName already registered under this enterprise?")) {
                $query = @("name=$appName", "url=$([uri]::EscapeDataString("https://$githubHost/enterprises/$enterprise"))", 'webhook_active=false') +
                    @($Permission.Keys | ForEach-Object { "$_=$($Permission[$_])" })
                Request-SetupManualStep -Message "Register the enterprise-owned GitHub App $appName. GitHub has no API for this step." -Url "$appsUrl/new?$($query -join '&')" -Guidance @(
                    "The link pre-fills: name $appName, webhook inactive, permissions $(Format-SetupPermission -Permission $Permission).",
                    'Keep every other permission at No access, then choose Create GitHub App.'
                )
                $lookup = Invoke-SetupApi -Setup $Setup -Uri "$api/apps/$appName"
            }
        }
        $appId = if ($lookup.Status -eq 'Ok' -and $lookup.Data -is [System.Collections.IDictionary]) { [string] $lookup.Data['id'] } else { '' }
        if (-not $appId) {
            $appId = Read-SetupValue -Prompt "App ID of $appName (App settings > General > About)" -Validate {
                param($text)
                if ($text -notmatch '^[1-9][0-9]*$') { 'The App ID is a positive number.' }
            }
        }
        $probe[$appIdKey] = $appId
        Save-SetupState -Setup $Setup
    }
    $appId = [string] $probe[$appIdKey]
    $key = Find-SetupAppKey -Setup $Setup -Role $Role -AppId $appId
    $app = $key.App
    if ($app['slug'] -ne $appName) {
        $probe.Remove($appIdKey)
        Save-SetupState -Setup $Setup
        Exit-SetupStage -Status Error -Message "App $appId has slug '$($app['slug'])'. Required: $appName." -Guidance @(
            "Check $appsUrl and enter the App ID of $appName, then choose [r]."
        )
    }
    $appSettings = "$appsUrl/$($app['slug'])"
    $owner = $app['owner']
    if (-not (Test-PlatformGitHubAppOwner -Owner $owner -Enterprise $enterprise)) {
        $probe.Remove($appIdKey)
        Save-SetupState -Setup $Setup
        Exit-SetupStage -Status Error -Message "App $appId is not owned by the enterprise $enterprise." -Guidance @(
            'Register the App under Your enterprise > Settings > GitHub Apps, not under a user or an organization.',
            'Delete the wrong App and its key, then choose [r].'
        )
    }
    if (-not (Test-SetupAppPermission -Actual $app['permissions'] -Expected $Permission)) {
        Exit-SetupStage -Status Error -Message "App $($app['slug']) has the permissions $(Format-SetupPermission -Permission $app['permissions']). Required: $(Format-SetupPermission -Permission $Permission)." -Guidance @(
            "$appSettings/permissions: set exactly the required permissions and Save changes. Then choose [r]."
        )
    }
    $jwt = ConvertTo-SetupAppJwt -AppId $appId -KeyPath $key.KeyPath
    $repositoryText = if ($Selection -eq 'none') { 'No repositories: this organization-only App does not require repository access' }
    elseif ($Selection -eq 'selected') { 'Only select repositories: instance-probe' }
    else { 'All repositories' }
    $installGuidance = @("App settings > Install App > $org > Install, $repositoryText.")
    $findInstallation = {
        $listed = Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri "$api/app/installations?per_page=100" -Token $jwt) -Action 'Listing the App installations'
        @($listed | Where-Object { $_ -is [System.Collections.IDictionary] -and $_['account'] -is [System.Collections.IDictionary] -and $_['account']['login'] -eq $org }) |
            Select-Object -First 1
    }
    $installation = & $findInstallation
    if (-not $installation) {
        Request-SetupManualStep -Message "Install $($app['slug']) in the organization $org." -Guidance $installGuidance -Url "$appSettings/installations"
        $installation = & $findInstallation
        if (-not $installation) { Exit-SetupStage -Status Missing -Message "$($app['slug']) is not installed in $org." -Guidance $installGuidance }
    }
    $installationUrl = "https://$githubHost/organizations/$org/settings/installations/$($installation['id'])"
    if ($installation['target_type'] -ne 'Organization' -or $installation['suspended_at']) {
        Exit-SetupStage -Status Error -Message "The installation in $org is suspended or not an organization installation." -Guidance @("${installationUrl}: unsuspend the installation, then choose [r].")
    }
    if ($Selection -ne 'none' -and $installation['repository_selection'] -ne $Selection) {
        Exit-SetupStage -Status Error -Message "The installation in $org has repository access '$($installation['repository_selection'])'. Required: $repositoryText." -Guidance @(
            "$installationUrl > Repository access: $repositoryText, then Save. Then choose [r]."
        )
    }
    if (-not (Test-SetupAppPermission -Actual $installation['permissions'] -Expected $Permission)) {
        Exit-SetupStage -Status Error -Message "The installation in $org has not accepted the App permissions." -Guidance @(
            "${installationUrl}: review and accept the requested permissions, then choose [r]."
        )
    }
    return @{ AppId = $appId; Slug = [string] $app['slug']; KeyPath = $key.KeyPath; InstallationId = [string] $installation['id']; Jwt = $jwt; SettingsUrl = $appSettings }
}

function Request-SetupProbeAppDeletion {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][ValidatePattern('^[a-z][a-z0-9-]*$')][string] $Role,
        [Parameter(Mandatory)][string] $Label
    )

    $probe = $Setup.State.probe
    $appIdKey = "$($Role)AppId"
    $appId = [string] $probe[$appIdKey]
    if (-not $appId) { return }
    $githubHost = $Setup.Settings['githubHost']
    $appName = "$($Setup.Settings['name'])-probe-$Role"
    $settingsUrl = "https://$githubHost/enterprises/$($Setup.Settings['enterprise'])/settings/apps/$appName/advanced"
    $keyPath = Join-Path $Setup.WorkPath "keys/probe-$Role.pem"
    Request-SetupManualStep -Message "Delete $Label ($appName). It is not needed anymore." -Url $settingsUrl -Guidance @(
        "Danger zone > Delete GitHub App, then confirm with the App name $appName."
    )
    if (Test-Path -LiteralPath $keyPath -PathType Leaf) {
        # GitHub rejects the JWT of a deleted App; the key stays until the rejection confirms the deletion.
        $response = Invoke-SetupApi -Setup $Setup -Uri "https://api.$githubHost/app" -Token (ConvertTo-SetupAppJwt -AppId $appId -KeyPath $keyPath)
        if ($response.Status -eq 'Ok') {
            Exit-SetupStage -Status Missing -Message "$Label ($appName) still exists: GitHub accepts its private key." -Guidance @(
                "${settingsUrl}: Danger zone > Delete GitHub App, then choose [r]."
            )
        }
        if ($response.Code -notin @(401, 404)) {
            Exit-SetupStage -Status Error -Area github -Message "Checking the deletion of $Label failed. $($response.Message)" -Guidance @('Choose [r] to check again.')
        }
        Remove-Item -LiteralPath $keyPath -Force
        Show-SetupMessage -Kind Ok -Message "$Label is deleted: GitHub rejects its private key with HTTP $($response.Code). The wizard deleted the key."
    }
    else {
        Show-SetupMessage -Kind Warning -Message "The private key $keyPath is missing. The wizard cannot verify the deletion of $Label and relies on your confirmation."
    }
    $probe.Remove($appIdKey)
    Save-SetupState -Setup $Setup
}

function Get-SetupInstallationToken {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][hashtable] $App,
        [Parameter(Mandatory)][System.Collections.IDictionary] $Permission
    )

    $response = Invoke-SetupApi -Setup $Setup -Uri "https://api.$($Setup.Settings['githubHost'])/app/installations/$($App.InstallationId)/access_tokens" `
        -Method POST -Body @{ permissions = $Permission } -Token $App.Jwt
    $issued = Assert-SetupResponse -Response $response -Action "Issuing an installation token with $(Format-SetupPermission -Permission $Permission)"
    if ($issued -isnot [System.Collections.IDictionary] -or -not $issued['token']) { Exit-SetupStage -Status Error -Message 'GitHub did not issue an installation token.' }
    return [string] $issued['token']
}

function Revoke-SetupInstallationToken {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [AllowEmptyCollection()][string[]] $Token = @()
    )

    foreach ($installationToken in $Token) {
        $response = Invoke-SetupApi -Setup $Setup -Uri "https://api.$($Setup.Settings['githubHost'])/installation/token" -Method DELETE -Token $installationToken
        if ($response.Code -notin @(204, 401)) { Show-SetupMessage -Kind Warning -Message "Revoking an installation token failed. $($response.Message) The token expires within 1 hour." }
    }
}

