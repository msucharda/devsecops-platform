#region Stage A9

function Invoke-SetupProbeOrganizationSignIn {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $org = $Setup.State.probe['organization']
    $login = $Setup.Facts.Login
    $api = "https://api.$($Setup.Settings['githubHost'])"
    Save-SetupState -Setup $Setup
    Show-SetupMessage -Kind Action -Message "USER ACTION: Sign in to GitHub again after creating $org so the OAuth token can access the new organization through SSO."
    Show-SetupGuidance -Line @(
        "Open https://$($Setup.Settings['githubHost'])/$org in the browser and complete any Entra ID sign-in.",
        "Use the same managed user $login for the GitHub CLI sign-in and authorize access to the new organization."
    )
    if (-not (Confirm-SetupAction -Prompt 'Sign in again now before creating the probe repository and team?' -DefaultYes)) {
        Exit-SetupStage -Status Missing -Area github -Message 'The new probe organization needs a fresh GitHub sign-in.' `
            -Guidance @('Choose [r] to complete the sign-in. The wizard keeps the existing organization.')
    }
    Invoke-SetupGitHubLogin -Setup $Setup
    $user = Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri "$api/user") -Action 'Checking the account after the probe organization sign-in'
    if ($user['login'] -ne $login) {
        Exit-SetupStage -Status Forbidden -Area github -Message "Sign in as $login, the owner used to create the probe organization." `
            -Guidance @('Choose [r] and sign in with the same managed user.')
    }
    Add-SetupGitHubScope -Setup $Setup -Scope @('admin:enterprise', 'admin:org', 'repo') -Purpose 'creating the probe repository and team after sign-in'
}

function Invoke-StepProbeOrg {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $probe = $Setup.State.probe
    if ($probe['authorizationPassed'] -and $probe['adminPassed'] -and -not $Setup.Reconfirm) {
        return "The App probes passed. Phase C uses the probe organization $($probe['organization']) until you delete it in phase D."
    }
    $api = "https://api.$($Setup.Settings['githubHost'])"
    $login = $Setup.Facts.Login
    $org = if ($probe['organization']) { [string] $probe['organization'] } else { "probe-$((Get-Date).ToString('yyyyMMdd'))" }
    $creationPending = [bool] $probe['organizationCreationPending']
    if ($probe['organizationSignInPending']) {
        Invoke-SetupProbeOrganizationSignIn -Setup $Setup
    }
    $orgResponse = Invoke-SetupApi -Setup $Setup -Uri "$api/orgs/$org"
    if ($creationPending -and $orgResponse.Status -eq 'Forbidden') {
        # The previous run lost the response of the creation: the organization exists and needs the SSO sign-in.
        $probe['organizationSignInPending'] = $true
        Save-SetupState -Setup $Setup
        Invoke-SetupProbeOrganizationSignIn -Setup $Setup
        $orgResponse = Invoke-SetupApi -Setup $Setup -Uri "$api/orgs/$org"
    }
    $null = Assert-SetupResponse -Response $orgResponse -Action "Reading the organization $org" -AllowMissing
    $orgMissing = $orgResponse.Status -eq 'Missing'
    if ($orgMissing -and $probe['organization'] -and $probe['organizationSignInPending']) {
        Exit-SetupStage -Status Error -Area github -Message "The organization $org was created but is not readable yet." -Guidance @('Wait a minute, then choose [r].')
    }
    if ($orgMissing -and $probe['organization'] -and -not $creationPending) {
        $stored = [string] $probe['organization']
        Show-SetupMessage -Kind Warning -Message "The probe organization $stored from setup-state.json no longer exists. GitHub keeps the name of a deleted organization blocked (ADR 0008)."
        $suggested = "probe-$((Get-Date).ToString('yyyyMMdd'))"
        if ($suggested -eq $stored) { $suggested = "probe-$((Get-Date).ToString('yyyyMMddHHmm'))" }
        $validateName = {
            param($text)
            if ($text -eq $stored) { "$stored is the name of the deleted organization. Enter another name." }
            elseif ($text.Length -gt 39 -or $text -cnotmatch '^[a-z0-9]+(-[a-z0-9]+)*$') { 'Use lowercase letters, digits and single hyphens, at most 39 characters.' }
        }.GetNewClosure()
        $org = Read-SetupValue -Prompt 'Name of the new probe organization' -Default $suggested -Validate $validateName
        # Probe results and the App B installation belong to the deleted organization; resumed runs must verify the new one.
        foreach ($key in @('authorizationPassed', 'adminPassed', 'adminInstallationId', 'adminReadRulesets')) { $probe.Remove($key) }
        Save-SetupState -Setup $Setup
    }
    $repoMissing = $orgMissing -or $null -eq (Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri "$api/repos/$org/instance-probe") -Action 'Reading the probe repository' -AllowMissing)
    $teamMissing = $orgMissing -or $null -eq (Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri "$api/orgs/$org/teams/platform-probe") -Action 'Reading the probe team' -AllowMissing)
    $membership = if ($teamMissing) { $null } else {
        Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri "$api/orgs/$org/teams/platform-probe/memberships/$login") -Action 'Reading the probe team membership' -AllowMissing
    }
    $memberMissing = $teamMissing -or $membership -isnot [System.Collections.IDictionary] -or $membership['state'] -ne 'active'
    $plan = @(
        if ($orgMissing) { "organization $org in the enterprise $($Setup.Settings['enterprise']) with you as owner" }
        if ($repoMissing) { "private repository $org/instance-probe" }
        if ($teamMissing) { "team $org/platform-probe" }
        if ($memberMissing) { "your active membership in platform-probe" }
    )
    if ($plan.Count -gt 0) {
        Show-SetupMessage -Message 'The App probes need a separate test organization. Delete it in phase D.'
        Show-SetupGuidance -Line $plan
        if (-not (Confirm-SetupAction -Prompt 'Create these now?' -DefaultYes)) {
            Exit-SetupStage -Status Missing -Message "The probe organization $org is incomplete." -Guidance @('Create the listed items, then choose [r].')
        }
        Add-SetupGitHubScope -Setup $Setup -Scope @('admin:enterprise', 'admin:org', 'repo') -Purpose 'creating the probe organization, repository and team'
        if ($orgMissing) {
            $billingEmail = if ($Setup.Facts.Upn) { $Setup.Facts.Upn } else {
                Read-SetupValue -Prompt 'Billing email of the probe organization' -Validate { param($text) if ($text -notmatch '^[^@\s]+@[^@\s]+$') { 'Enter an email address.' } }
            }
            $mutation = 'mutation($input:CreateEnterpriseOrganizationInput!){createEnterpriseOrganization(input:$input){organization{login}}}'
            # Save the intent before the write, so a rerun after a lost response finds the organization.
            $previousOrganization = $probe['organization']
            $probe['organization'] = $org
            $probe['organizationCreationPending'] = $true
            Save-SetupState -Setup $Setup
            # The mutation is not idempotent: a single attempt lets a rejection prove that this request created nothing.
            $creation = Invoke-SetupApi -Setup $Setup -Uri "$api/graphql" -Method POST -NoRetry -Body @{
                query = $mutation
                variables = @{ input = @{ enterpriseId = $Setup.Facts.EnterpriseId; login = $org; profileName = $org; billingEmail = $billingEmail; adminLogins = @($login) } }
            }
            if (-not $creationPending -and (Test-SetupGraphQLRejected -Response $creation) -and -not (Get-SetupCreatedOrganization -Response $creation)) {
                # GitHub refused the name of a new request, so no organization exists: the next run must offer another name.
                # A resumed creation stays pending, because the lost earlier request may have created the organization.
                $probe.Remove('organizationCreationPending')
                if ($previousOrganization) { $probe['organization'] = $previousOrganization } else { $probe.Remove('organization') }
                Save-SetupState -Setup $Setup
            }
            $null = Get-SetupGraphQLData -Response $creation -Action "Creating the organization $org"
            $probe.Remove('organizationCreationPending')
            $probe['organizationSignInPending'] = $true
            Save-SetupState -Setup $Setup
            Invoke-SetupProbeOrganizationSignIn -Setup $Setup
            $created = Wait-SetupCondition -TimeoutSeconds 120 -IntervalSeconds 5 -Activity "Waiting for the organization $org" -Condition {
                (Invoke-SetupApi -Setup $Setup -Uri "$api/orgs/$org").Status -eq 'Ok'
            }
            if (-not $created) { Exit-SetupStage -Status Error -Area github -Message "The organization $org is not readable yet." -Guidance @('Wait a minute, then choose [r].') }
        }
        $probe['organization'] = $org
        Save-SetupState -Setup $Setup
        if ($repoMissing) {
            $null = Assert-SetupResponse -Action 'Creating the probe repository' -Response (Invoke-SetupApi -Setup $Setup -Uri "$api/orgs/$org/repos" -Method POST -Body @{
                name = 'instance-probe'; private = $true; auto_init = $true; description = 'GitHub App probe. Delete in phase D.'
            })
        }
        if ($teamMissing) {
            $null = Assert-SetupResponse -Action 'Creating the probe team' -Response (Invoke-SetupApi -Setup $Setup -Uri "$api/orgs/$org/teams" -Method POST -Body @{
                name = 'platform-probe'; privacy = 'closed'
            })
        }
        $membership = Assert-SetupResponse -Action 'Adding you to the probe team' -Response (Invoke-SetupApi -Setup $Setup -Uri "$api/orgs/$org/teams/platform-probe/memberships/$login" -Method PUT -Body @{ role = 'maintainer' })
        if ($membership -isnot [System.Collections.IDictionary] -or $membership['state'] -ne 'active') {
            Exit-SetupStage -Status Error -Area github -Message "Your membership in platform-probe is not active." -Guidance @("https://$($Setup.Settings['githubHost'])/orgs/$org/teams/platform-probe: check your membership, then choose [r].")
        }
    }
    $probe['organization'] = $org
    $probe['organizationSignInPending'] = $false
    $probe.Remove('organizationCreationPending')
    Save-SetupState -Setup $Setup
    return "The probe organization $org has the private repository instance-probe and the team platform-probe with your active membership."
}

function Invoke-StepProbeAuthorization {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $probe = $Setup.State.probe
    $passed = "The authorization token probe passed on $($probe['authorizationPassed'])."
    $skipProbe = $probe['authorizationPassed'] -and (-not $Setup.Reconfirm -or $Setup.Facts.AuthorizationProbePassed)
    if ($probe['authorizationPassed'] -and $probe['authorizationAppId']) {
        # A passed probe left App A behind; -Reconfirm repeats the probe only after its deletion.
        Request-SetupProbeAppDeletion -Setup $Setup -Role authorization -Label 'App A'
        if ($skipProbe) { return "$passed App A is deleted." }
    }
    elseif ($skipProbe) { return $passed }
    if ($probe['authorizationPassed']) {
        # -Reconfirm repeats the probe; a retry must not treat the replacement App A as the leftover of a passed probe.
        $probe.Remove('authorizationPassed')
        Save-SetupState -Setup $Setup
    }
    $githubHost = $Setup.Settings['githubHost']
    $api = "https://api.$githubHost"
    $org = $probe['organization']
    $login = $Setup.Facts.Login
    $findingGuidance = @('Record the finding in issue #10. Do not switch to a PAT and do not extend the App permissions.')
    Show-SetupMessage -Message 'App A checks the token that deploy.yml uses to verify that the PR author belongs to the platform team.'
    $app = Get-SetupProbeApp -Setup $Setup -Role authorization -Permission ([ordered]@{ members = 'read' }) -Selection none
    $envFile = Join-Path $Setup.WorkPath 'probe-authorization.env'
    $saved = @{}
    foreach ($variable in $script:AppVariables) { $saved[$variable] = [Environment]::GetEnvironmentVariable($variable, 'Process') }
    $token = $null
    try {
        [Environment]::SetEnvironmentVariable('GITHUB_REPOSITORY', "$org/instance-probe", 'Process')
        [Environment]::SetEnvironmentVariable('PLATFORM_APP_ID', $app.AppId, 'Process')
        [Environment]::SetEnvironmentVariable('PLATFORM_APP_INSTALLATION_ID', $app.InstallationId, 'Process')
        [Environment]::SetEnvironmentVariable('PLATFORM_APP_ENTERPRISE', $Setup.Settings['enterprise'], 'Process')
        [Environment]::SetEnvironmentVariable('PLATFORM_APP_PRIVATE_KEY', (Get-Content -LiteralPath $app.KeyPath -Raw), 'Process')
        [Environment]::SetEnvironmentVariable('PLATFORM_GITHUB_TOKENS', $null, 'Process')
        Remove-Item -LiteralPath $envFile -Force -ErrorAction SilentlyContinue
        try {
            & (Join-Path $Setup.RepoPath 'tools/New-PlatformGitHubToken.ps1') -Authorization -EnvironmentPath $envFile -ApiUrl $api 6>$null
        }
        catch {
            Exit-SetupStage -Status Error -Message "The token tool failed: $($_.Exception.Message)" -Guidance (@('Fix the App or the installation if the message names them, then choose [r].') + $findingGuidance)
        }
        $lines = @(Get-Content -LiteralPath $envFile)
        $tokenLine = @($lines | Where-Object { $_ -like 'GH_TOKEN=*' }) | Select-Object -First 1
        $tokensLine = @($lines | Where-Object { $_ -like 'PLATFORM_GITHUB_TOKENS=*' }) | Select-Object -First 1
        if (-not $tokenLine -or -not $tokensLine) { Exit-SetupStage -Status Error -Message 'The token tool did not write GH_TOKEN and PLATFORM_GITHUB_TOKENS.' -Guidance $findingGuidance }
        $token = $tokenLine.Substring(9)
        $membershipUri = "$api/orgs/$org/teams/platform-probe/memberships/$login"
        $membership = Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri $membershipUri -Token $token) -Action 'Reading the team membership with the App token' -Guidance $findingGuidance
        if ($membership -isnot [System.Collections.IDictionary] -or $membership['state'] -ne 'active') {
            Exit-SetupStage -Status Error -Message 'The App token does not see your active team membership.' -Guidance $findingGuidance
        }
        [Environment]::SetEnvironmentVariable('PLATFORM_GITHUB_TOKENS', $tokensLine.Substring(23), 'Process')
        try {
            & (Join-Path $Setup.RepoPath 'tools/Remove-PlatformGitHubToken.ps1') -ApiUrl $api
        }
        catch {
            Exit-SetupStage -Status Error -Message "The revocation tool failed: $($_.Exception.Message)" -Guidance $findingGuidance
        }
        $after = Invoke-SetupApi -Setup $Setup -Uri $membershipUri -Token $token
        if ($after.Code -ne 401) { Exit-SetupStage -Status Error -Message "The revoked token returned HTTP $($after.Code) instead of 401." -Guidance $findingGuidance }
        $token = $null
    }
    finally {
        if ($token) { Revoke-SetupInstallationToken -Setup $Setup -Token @($token) }
        foreach ($variable in $script:AppVariables) { [Environment]::SetEnvironmentVariable($variable, $saved[$variable], 'Process') }
        Remove-Item -LiteralPath $envFile -Force -ErrorAction SilentlyContinue
    }
    $probe['authorizationPassed'] = (Get-Date).ToString('o')
    $Setup.Facts.AuthorizationProbePassed = $true
    Save-SetupState -Setup $Setup
    Show-SetupMessage -Kind Ok -Message 'The token tool issued the authorization token, the token read your active membership and returned 401 after revocation.'
    Request-SetupProbeAppDeletion -Setup $Setup -Role authorization -Label 'App A'
    return 'The authorization token probe passed and App A is deleted.'
}

function Invoke-StepProbeAdmin {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $probe = $Setup.State.probe
    if ($probe['adminPassed'] -and -not $Setup.Reconfirm) { return "The organization API probe passed on $($probe['adminPassed']). Keep App B for phase C." }
    if ($probe['adminPassed']) {
        # -Reconfirm repeats the probe; a failed recheck must not leave the earlier pass behind for the next run.
        $probe.Remove('adminPassed')
        Save-SetupState -Setup $Setup
    }
    $api = "https://api.$($Setup.Settings['githubHost'])"
    $org = $probe['organization']
    $rulesetName = 'instance-setup-probe'
    $findingGuidance = @('Record the finding in issue #10. Do not switch to a PAT and do not extend the App permissions.')
    Show-SetupMessage -Message 'App B checks that App tokens read organization policies and rulesets including bypass actors.'
    $app = Get-SetupProbeApp -Setup $Setup -Role admin -Selection none -Permission ([ordered]@{
        organization_administration = 'write'; members = 'write'; organization_custom_org_roles = 'read'
    })
    $issued = [System.Collections.Generic.List[string]]::new()
    try {
        $readToken = Get-SetupInstallationToken -Setup $Setup -App $app -Permission @{ organization_administration = 'read' }
        $issued.Add($readToken)
        foreach ($path in @("/orgs/$org/actions/permissions", "/orgs/$org/code-security/configurations")) {
            $null = Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri "$api$path" -Token $readToken) -Action "Reading $path with a read token" -Guidance $findingGuidance
        }
        $readRulesets = Invoke-SetupApi -Setup $Setup -Uri "$api/orgs/$org/rulesets" -Token $readToken
        $probe['adminReadRulesets'] = "HTTP $($readRulesets.Code)"
        Show-SetupMessage -Message "Listing rulesets with a read token returned HTTP $($readRulesets.Code). ADR 0016 expects rulesets to need write."
        $writeToken = Get-SetupInstallationToken -Setup $Setup -App $app -Permission @{ organization_administration = 'write' }
        $issued.Add($writeToken)
        $rulesets = Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri "$api/orgs/$org/rulesets" -Token $writeToken) -Action 'Listing rulesets with a write token' -Guidance $findingGuidance
        foreach ($stale in @($rulesets | Where-Object { $_ -is [System.Collections.IDictionary] -and $_['name'] -eq $rulesetName })) {
            $null = Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri "$api/orgs/$org/rulesets/$($stale['id'])" -Method DELETE -Token $writeToken) -Action 'Deleting a stale probe ruleset'
        }
        $created = Assert-SetupResponse -Action 'Creating a disabled probe ruleset' -Guidance $findingGuidance -Response (Invoke-SetupApi -Setup $Setup -Uri "$api/orgs/$org/rulesets" -Method POST -Token $writeToken -Body @{
            name = $rulesetName
            target = 'branch'
            enforcement = 'disabled'
            bypass_actors = @(@{ actor_id = 1; actor_type = 'OrganizationAdmin'; bypass_mode = 'always' })
            conditions = @{
                ref_name = @{ include = @('~DEFAULT_BRANCH'); exclude = @() }
                repository_name = @{ include = @('~ALL'); exclude = @() }
            }
            rules = @(@{ type = 'deletion' })
        })
        if ($created -isnot [System.Collections.IDictionary] -or -not $created['id']) { Exit-SetupStage -Status Error -Message 'GitHub did not return the probe ruleset.' -Guidance $findingGuidance }
        $rulesetUri = "$api/orgs/$org/rulesets/$($created['id'])"
        $deletedProbe = $false
        try {
            $detail = Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri $rulesetUri -Token $writeToken) -Action 'Reading the probe ruleset' -Guidance $findingGuidance
            $bypass = if ($detail -is [System.Collections.IDictionary]) { @($detail['bypass_actors'] | Where-Object { $_ -is [System.Collections.IDictionary] -and $_['actor_type'] -eq 'OrganizationAdmin' }) } else { @() }
            if ($bypass.Count -eq 0) { Exit-SetupStage -Status Error -Message 'The ruleset detail does not return the OrganizationAdmin bypass actor.' -Guidance $findingGuidance }
        }
        finally {
            $deleted = Invoke-SetupApi -Setup $Setup -Uri $rulesetUri -Method DELETE -Token $writeToken
            $deletedProbe = $deleted.Status -eq 'Ok'
            if (-not $deletedProbe) {
                Show-SetupMessage -Kind Warning -Message "Deleting the probe ruleset failed. $($deleted.Message) Delete $rulesetName in the organization settings of $org."
            }
        }
        # A passed probe skips the step on resume; the stale ruleset deletion above runs only when the probe repeats.
        if (-not $deletedProbe) {
            Exit-SetupStage -Status Error -Area github -Message "The probe ruleset $rulesetName in $org was not deleted." `
                -Guidance @('Choose [r]. The probe deletes the stale ruleset before it creates a new one.')
        }
    }
    finally {
        Revoke-SetupInstallationToken -Setup $Setup -Token $issued.ToArray()
    }
    $probe['adminAppId'] = $app.AppId
    $probe['adminInstallationId'] = $app.InstallationId
    $probe['adminPassed'] = (Get-Date).ToString('o')
    Save-SetupState -Setup $Setup
    return "The organization API probe passed. Keep App B ($($app.Slug)) and $($app.KeyPath) for phase C."
}

