      "changes": 39,
      "blob_url": "https://github.com/msucharda/devsecops-platform/blob/8cd6ef63ea1de539b77154b17a8e63633b1993c6/.github%2Fworkflows%2Fci.yml",
      "raw_url": "https://github.com/msucharda/devsecops-platform/raw/8cd6ef63ea1de539b77154b17a8e63633b1993c6/.github%2Fworkflows%2Fci.yml",
      "contents_url": "https://api.github.com/repos/msucharda/devsecops-platform/contents/.github%2Fworkflows%2Fci.yml?ref=8cd6ef63ea1de539b77154b17a8e63633b1993c6",
      "patch": "@@ -64,6 +64,45 @@ jobs:\n           path: artifacts/pester.xml\n           if-no-files-found: error\n \n+  interruption:\n+    name: Interruption harness (${{ matrix.shard }}/4)\n+    runs-on: ubuntu-latest\n+    timeout-minutes: 10\n+    strategy:\n+      fail-fast: false\n+      matrix:\n+        shard: [0, 1, 2, 3]\n+    env:\n+      INTERRUPTION_SHARD: ${{ matrix.shard }}/4\n+    steps:\n+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262\n+      - name: Install tool dependencies\n+        shell: pwsh\n+        run: ./tools/Install-ToolDependencies.ps1 -Development\n+      - name: Interrupt every state-changing step\n+        shell: pwsh\n+        run: ./tools/Invoke-Tests.ps1 -Tag Interruption\n+\n+  mutation:\n+    name: Security check mutation tests\n+    runs-on: ubuntu-latest\n+    timeout-minutes: 10\n+    steps:\n+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262\n+      - name: Install tool dependencies\n+        shell: pwsh\n+        run: ./tools/Install-ToolDependencies.ps1 -Development\n+      - name: Weaken every marked security check\n+        shell: pwsh\n+        run: ./tools/Invoke-MutationTests.ps1 -ReportPath ./artifacts/mutation-report.json\n+      - name: Upload mutation report\n+        if: ${{ !cancelled() && hashFiles('artifacts/mutation-report.json') != '' }}\n+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n+        with:\n+          name: mutation-report\n+          path: artifacts/mutation-report.json\n+          if-no-files-found: error\n+\n   terraform:\n     name: Terraform (${{ matrix.root }})\n     needs: platform"
    },
