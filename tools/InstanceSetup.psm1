#region State and confirmations

function Read-SetupState {
    [CmdletBinding()]
    [OutputType([hashtable])]
    param([Parameter(Mandatory)][string] $Path)

    $state = @{ confirmations = @{}; probe = @{} }
    if (-not (Test-Path -LiteralPath $Path)) { return $state }
    try {
        $loaded = ConvertFrom-Json -InputObject (Get-Content -LiteralPath $Path -Raw) -AsHashtable -ErrorAction Stop
        foreach ($key in @('confirmations', 'probe', 'acceptance')) {
            if ($loaded -is [System.Collections.IDictionary] -and $loaded[$key] -is [System.Collections.IDictionary]) { $state[$key] = $loaded[$key] }
        }
    }
    catch {
        Write-Warning -Message "Ignoring unreadable setup state '$Path': $($_.Exception.Message)"
    }
    return $state
}

function ConvertTo-SetupSortedValue {
    [CmdletBinding()]
    param([AllowNull()] $Value)

    if ($Value -is [System.Collections.IDictionary]) {
        $keys = [string[]] @($Value.Keys)
        [Array]::Sort($keys, [System.StringComparer]::Ordinal)
        $sorted = [ordered]@{}
        foreach ($key in $keys) { $sorted[$key] = ConvertTo-SetupSortedValue -Value $Value[$key] }
        return $sorted
    }
    if ($Value -is [System.Collections.IList]) {
        return , @(foreach ($item in $Value) { ConvertTo-SetupSortedValue -Value $item })
    }
    return $Value
}

function Save-SetupState {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    # Hashtable order changes between processes; sorted keys keep an unchanged state byte-identical.
    $json = ConvertTo-Json -InputObject (ConvertTo-SetupSortedValue -Value $Setup.State) -Depth 10
    if ((Test-Path -LiteralPath $Setup.StatePath -PathType Leaf) -and [System.IO.File]::ReadAllText($Setup.StatePath) -ceq $json) { return }
    [System.IO.File]::WriteAllText($Setup.StatePath, $json, [System.Text.UTF8Encoding]::new($false))
}

function Test-SetupExistingFlag {
    [CmdletBinding()]
    [OutputType([bool])]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string] $Name
    )

    $existing = $Setup.Existing
    return $existing -is [System.Collections.IDictionary] -and
        $existing['manualPrerequisites'] -is [System.Collections.IDictionary] -and
        $existing['manualPrerequisites'][$Name] -eq $true
}

function Confirm-SetupPrerequisite {
    [CmdletBinding()]
    [OutputType([bool])]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string] $Name,
        [Parameter(Mandatory)][string[]] $Guidance,
        [Parameter(Mandatory)][string] $Prompt
    )

    $confirmations = $Setup.State.confirmations
    if (-not $Setup.Reconfirm) {
        if ($confirmations[$Name]) {
            Show-SetupMessage -Kind Ok -Message "$Name was confirmed on $($confirmations[$Name])."
            return $true
        }
        if (Test-SetupExistingFlag -Setup $Setup -Name $Name) {
            $confirmations[$Name] = (Get-Date).ToString('o')
            Save-SetupState -Setup $Setup
            Show-SetupMessage -Kind Ok -Message "$Name is confirmed in instance.yaml."
            return $true
        }
    }
    Show-SetupMessage -Kind Action -Message "USER ACTION: $Name. Check the setting in the UI; the wizard cannot set or verify it through an API."
    Show-SetupGuidance -Line $Guidance
    if (-not (Confirm-SetupAction -Prompt $Prompt)) {
        if ($confirmations.Contains($Name)) {
            $confirmations.Remove($Name)
            Save-SetupState -Setup $Setup
        }
        return $false
    }
    $confirmations[$Name] = (Get-Date).ToString('o')
    Save-SetupState -Setup $Setup
    return $true
}

