#region Azure access

function Get-SetupMissingAction {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string] $Scope,
        [Parameter(Mandatory)][string[]] $Operation
    )

    # The permissions API omits ABAC conditions and deny assignments, so a match is necessary but not sufficient.
    $response = Invoke-SetupApi -Setup $Setup -Uri "$script:Arm$Scope/providers/Microsoft.Authorization/permissions?api-version=2022-04-01"
    if ($response.Status -eq 'Forbidden') { return $Operation }
    $null = Assert-SetupResponse -Response $response -Action "Reading your permissions at $Scope"
    $permissionSets = @(Get-SetupCollection -Setup $Setup -Uri "$script:Arm$Scope/providers/Microsoft.Authorization/permissions?api-version=2022-04-01" -Action "Reading your permissions at $Scope")
    foreach ($operationName in $Operation) {
        $allowed = @($permissionSets | Where-Object {
            $permissionSet = $_
            @($permissionSet['actions'] | Where-Object { $operationName -like $_ }).Count -gt 0 -and
            @($permissionSet['notActions'] | Where-Object { $operationName -like $_ }).Count -eq 0
        }).Count -gt 0
        if (-not $allowed) { $operationName }
    }
}

function Test-SetupGlobalAdministrator {
    [CmdletBinding()]
    [OutputType([bool])]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $roles = @(Get-SetupCollection -Setup $Setup -Uri "$script:Graph/me/memberOf/microsoft.graph.directoryRole" -Action 'Reading your active directory roles')
    return @($roles | Where-Object { $_['roleTemplateId'] -eq $script:RoleGlobalAdministrator }).Count -gt 0
}

function Get-SetupRootAccess {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $filter = [uri]::EscapeDataString("principalId eq '$($Setup.Facts.Me)'")
    $uri = "$script:Arm/providers/Microsoft.Authorization/roleAssignments?api-version=2022-04-01&`$filter=$filter"
    if ((Invoke-SetupApi -Setup $Setup -Uri $uri).Status -eq 'Forbidden') { return }
    @(Get-SetupCollection -Setup $Setup -Uri $uri -Action 'Reading role assignments at the root scope') | Where-Object {
        $_['properties']['scope'] -eq '/' -and ($_['properties']['roleDefinitionId'] -split '/')[-1] -eq $script:RoleUserAccessAdministrator
    }
}

function Invoke-SetupElevationRevoke {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [switch] $ExpectAssignment
    )

    try {
        $assignments = if ($ExpectAssignment) {
            Wait-SetupCondition -TimeoutSeconds 120 -IntervalSeconds 10 -Activity 'Looking up the elevated access assignment' -Condition {
                Get-SetupRootAccess -Setup $Setup
            }
        }
        else {
            Get-SetupRootAccess -Setup $Setup
        }
        $assignments = @($assignments | Where-Object { $_ })
        if ($ExpectAssignment -and $assignments.Count -eq 0) { throw 'The elevated access assignment was not found.' }
        if ($assignments.Count -eq 0) {
            Show-SetupMessage -Kind Warning -Message 'No elevated access assignment was found. Azure can show a new assignment with a delay.'
            Show-SetupGuidance -Line @(
                'Check it: Entra admin center > Identity > Overview > Properties >',
                'Access management for Azure resources = No.'
            )
            return
        }
        foreach ($assignment in $assignments) {
            $response = Invoke-SetupApi -Setup $Setup -Uri "$script:Arm$($assignment['id'])?api-version=2022-04-01" -Method DELETE
            $null = Assert-SetupResponse -Response $response -Action 'Removing elevated access'
        }
        Show-SetupMessage -Kind Ok -Message "Elevated access removed ($($assignments.Count) assignment)."
    }
    catch {
        Show-SetupMessage -Kind Error -Message "ELEVATED ACCESS MAY STILL BE ACTIVE: $($_.Exception.Message)"
        Show-SetupGuidance -Line @(
            'Remove it now: Entra admin center > Identity > Overview > Properties >',
            'Access management for Azure resources = No, then Save.'
        )
    }
}

function Invoke-SetupElevatedAction {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string] $Purpose,
        [Parameter(Mandatory)][scriptblock] $Action,
        [Parameter(Mandatory)][string[]] $AdminGuidance
    )

    if (-not (Test-SetupGlobalAdministrator -Setup $Setup)) {
        Exit-SetupStage -Status Forbidden -Area azure -Message "$Purpose requires an active Global Administrator role." -Guidance (@(
            'Activate Global Administrator: Entra admin center > Identity Governance > Privileged Identity Management > My roles.',
            'Then choose [l] so the wizard uses a fresh Azure sign-in.',
            'Or ask a Global Administrator to run:'
        ) + $AdminGuidance)
    }
    Show-SetupMessage -Kind Warning -Message "$Purpose needs temporary elevated access: User Access Administrator at the root scope '/'."
    Show-SetupMessage -Kind Warning -Message 'The wizard removes the elevation right after the action, also when the action fails.'
    if (-not (Confirm-SetupAction -Prompt 'Elevate access now?')) {
        Exit-SetupStage -Status Missing -Message "$Purpose was declined." -Guidance (@('Ask a Global Administrator to run:') + $AdminGuidance)
    }
    $existing = @(Get-SetupRootAccess -Setup $Setup)
    # Unclear covers a failed or interrupted request that may have reached Azure; Rejected means Azure created no elevation.
    $elevation = if ($existing.Count -gt 0) { 'Existing' } else { 'Unclear' }
    try {
        if ($elevation -eq 'Unclear') {
            $response = Invoke-SetupApi -Setup $Setup -Uri "$script:Arm/providers/Microsoft.Authorization/elevateAccess?api-version=2016-07-01" -Method POST
            if ($response.Status -eq 'Forbidden') {
                $elevation = 'Rejected'
                $null = Assert-SetupResponse -Response $response -Action 'Elevating access' -Guidance @(
                    'Azure denied the elevation. Elevation needs an Azure token issued after the Global Administrator activation.',
                    'If the token details above show no Global Administrator in wids, choose [l]. The wizard signs you out of Azure CLI and in again to get new tokens.'
                )
            }
            $null = Assert-SetupResponse -Response $response -Action 'Elevating access'
            $elevation = 'Active'
            Show-SetupMessage -Kind Ok -Message 'Elevated access is active.'
        }
        & $Action
    }
    finally {
        switch ($elevation) {
            'Active' { Invoke-SetupElevationRevoke -Setup $Setup -ExpectAssignment }
            'Unclear' {
                Show-SetupMessage -Kind Warning -Message 'The elevation request ended with an unclear result. The wizard removes any elevated access it finds.'
                Invoke-SetupElevationRevoke -Setup $Setup
            }
            'Existing' {
                if (Confirm-SetupAction -Prompt 'Elevated access existed before the wizard started. Remove it now?' -DefaultYes) {
                    Invoke-SetupElevationRevoke -Setup $Setup
                }
            }
        }
    }
}

function Invoke-SetupRoleAssignment {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string] $Scope,
        [Parameter(Mandatory)][string] $RoleId
    )

    $principalId = $Setup.Facts.Me
    $roleDefinitionId = "$Scope/providers/Microsoft.Authorization/roleDefinitions/$RoleId"
    $hash = [System.Security.Cryptography.SHA256]::HashData([System.Text.Encoding]::UTF8.GetBytes("$Scope|$principalId|$roleDefinitionId".ToLowerInvariant()))
    $assignmentName = [guid]::new([byte[]] $hash[0..15]).ToString()
    $assignmentUri = "$script:Arm$Scope/providers/Microsoft.Authorization/roleAssignments/$assignmentName`?api-version=2022-04-01"
    $assignmentBody = @{ properties = @{ principalId = $principalId; principalType = 'User'; roleDefinitionId = $roleDefinitionId } }
    $response = Wait-SetupCondition -TimeoutSeconds 600 -IntervalSeconds 10 -Activity 'Waiting for elevated access to take effect' -Condition {
        $assignmentAttempt = Invoke-SetupApi -Setup $Setup -Uri $assignmentUri -Method PUT -Body $assignmentBody
        if ($assignmentAttempt.Status -ne 'Forbidden') { $assignmentAttempt }
    }
    if (-not $response) {
        Exit-SetupStage -Status Forbidden -Area azure -Message "Elevated access did not allow the role assignment at $Scope within 10 minutes." `
            -Guidance @('Choose [r] to try again.')
    }
    if ($response.Code -eq 409) { return }
    $null = Assert-SetupResponse -Response $response -Action "Assigning the role at $Scope"
    Show-SetupMessage -Kind Ok -Message "Role assigned at $Scope."
}

