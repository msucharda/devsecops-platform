#Requires -Version 7.4
# Interactive setup wizard for phase A of docs/reference-instance.md.
# It verifies every prerequisite, performs the changes that have an API after explicit confirmation,
# guides the remaining manual steps and writes instance.yaml only from verified results.

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$PSNativeCommandUseErrorActionPreference = $false

$script:Arm = 'https://management.azure.com'
$script:Graph = 'https://graph.microsoft.com/v1.0'
$script:RoleOwner = '8e3af657-a8ff-443c-a75c-2fe8c4bcb635'
$script:RoleManagementGroupReader = 'ac63b705-f282-497d-ac71-919bf39d939d'
$script:RoleUserAccessAdministrator = '18d7d88d-d35e-4fb5-a5c3-7773c20a72d9'
$script:RoleGlobalAdministrator = '62e90394-69f5-4237-9190-012177145e10'
$script:EmuApplicationName = 'GitHub Enterprise Managed User (OIDC)'
$script:TokenVariables = @('GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN', 'GITHUB_ENTERPRISE_TOKEN')
$script:AppVariables = @('GITHUB_REPOSITORY', 'PLATFORM_APP_ID', 'PLATFORM_APP_INSTALLATION_ID', 'PLATFORM_APP_ENTERPRISE', 'PLATFORM_APP_PRIVATE_KEY', 'PLATFORM_GITHUB_TOKENS')
$script:SessionMarker = '# Generated by tools/Start-InstanceSetup.ps1.'
$script:BootstrapActions = @(
    'Microsoft.Resources/subscriptions/resourceGroups/write'
    'Microsoft.Storage/storageAccounts/write'
    'Microsoft.Storage/storageAccounts/blobServices/write'
    'Microsoft.Storage/storageAccounts/blobServices/containers/write'
    'Microsoft.Authorization/locks/write'
    'Microsoft.ManagedIdentity/userAssignedIdentities/write'
    'Microsoft.Authorization/roleAssignments/write'
    'Microsoft.Authorization/roleAssignments/read'
)
$script:ResourceProviders = @('Microsoft.Storage', 'Microsoft.ManagedIdentity', 'Microsoft.ContainerInstance')
$script:PolicySettings = [ordered]@{
    allowPrivateRepositoryForkingSetting = 'AllowPrivateRepositoryForking'
    membersCanCreateRepositoriesSetting = 'MembersCanCreateRepositories'
    membersCanChangeRepositoryVisibilitySetting = 'MembersCanChangeRepositoryVisibility'
    membersCanDeleteRepositoriesSetting = 'MembersCanDeleteRepositories'
}
$script:ConfigOrder = @(
    'instance', 'regions', 'teams', 'modules', 'customPatterns', 'manualSteps', 'bootstrap',
    'manualPrerequisites', 'githubApps', 'credentials', 'teardown'
)
$script:FlagOrder = @(
    'tenant', 'subscriptions', 'enterpriseOidc', 'enterpriseScim', 'enterpriseOwner', 'licenses',
    'privateInternalForksDisabled', 'repositoryManagementPoliciesEnforced', 'emuUserNamespacesRestricted',
    'fineGrainedPatApprovalRequired', 'patMaxLifetime90Days', 'githubAppAvailabilityVerified', 'liveWorkflowsPromoted'
)
$script:ConfirmedPolicies = [ordered]@{
    emuUserNamespacesRestricted = @(
        'Your enterprise > Policies > Member privileges > Repository creation (not Repositories > Policies > New policy):',
        'turn on "Block the creation of user namespace repositories", then Save.'
    )
    fineGrainedPatApprovalRequired = @(
        'Your enterprise > Policies > Personal access tokens > Fine-grained tokens:',
        'turn on "Require organizations to use the approval flow", then Save.',
        'Organization members must get approval for fine-grained PATs accessing enterprise organizations; organization administrators cannot disable the approval flow.'
    )
    patMaxLifetime90Days = @(
        'Your enterprise > Policies > Personal access tokens, on both tabs Fine-grained tokens and Tokens (classic):',
        'turn on "Set maximum lifetimes for personal access tokens" with 90 days and turn on "Exempt administrators".',
        'The exemption keeps the SCIM token of the setup user valid. Do not restrict classic PATs otherwise.'
    )
}

#region Failures

function Exit-SetupStage {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][ValidateSet('Missing', 'Forbidden', 'Error')][string] $Status,
        [Parameter(Mandatory)][string] $Message,
        [string[]] $Guidance = @(),
        [ValidateSet('', 'azure', 'github')][string] $Area = ''
    )

    $exception = [System.InvalidOperationException]::new($Message)
    $exception.Data['SetupStatus'] = $Status
    $exception.Data['SetupGuidance'] = [string[]] @($Guidance)
    $exception.Data['SetupArea'] = $Area
    throw $exception
}

function Exit-SetupWizard {
    [CmdletBinding()]
    param([string] $Message = 'Setup stopped at your request.')

    $exception = [System.OperationCanceledException]::new($Message)
    $exception.Data['SetupQuit'] = $true
    throw $exception
}

function Get-SetupFailure {
    [CmdletBinding()]
    [OutputType([hashtable])]
    param([Parameter(Mandatory)][System.Management.Automation.ErrorRecord] $ErrorRecord)

    $exception = $ErrorRecord.Exception
    while ($null -ne $exception) {
        if ($exception.Data.Contains('SetupQuit')) {
            return @{ Quit = $true; Status = 'Error'; Message = $exception.Message; Guidance = @(); Area = '' }
        }
        if ($exception.Data.Contains('SetupStatus')) {
            return @{
                Quit = $false
                Status = [string] $exception.Data['SetupStatus']
                Message = $exception.Message
                Guidance = @($exception.Data['SetupGuidance'])
                Area = [string] $exception.Data['SetupArea']
            }
        }
        $exception = $exception.InnerException
    }
    return @{ Quit = $false; Status = 'Error'; Message = $ErrorRecord.Exception.Message; Guidance = @(); Area = '' }
}

#endregion

#region Output

function Show-SetupMessage {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][AllowEmptyString()][string] $Message,
        [ValidateSet('Info', 'Ok', 'Warning', 'Error', 'Action', 'Title')][string] $Kind = 'Info'
    )

    $styles = @{
        Info = @('   ', 'Gray'); Ok = @('OK ', 'Green'); Warning = @('!! ', 'Yellow')
        Error = @('XX ', 'Red'); Action = @('>> ', 'Cyan'); Title = @('', 'White')
    }
    Write-Host -Object ($styles[$Kind][0] + $Message) -ForegroundColor $styles[$Kind][1]
}

function Show-SetupGuidance {
    [CmdletBinding()]
    param([AllowEmptyCollection()][string[]] $Line = @())

    foreach ($text in $Line) { Write-Host -Object "     $text" -ForegroundColor Cyan }
}

function Show-SetupStageHeader {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string] $Step,
        [Parameter(Mandatory)][string] $Title
    )

    Write-Host ''
    Write-Host -Object "== [$Step] $Title ==" -ForegroundColor White
}

function Show-SetupTable {
    [CmdletBinding()]
    param([AllowEmptyCollection()][object[]] $Row = @())

    if ($Row.Count -eq 0) { return }
    $text = $Row | Format-Table -AutoSize -Wrap | Out-String -Width 200
    Write-Host -Object $text.TrimEnd()
}

#endregion

#region Prompts

function Read-SetupValue {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)][string] $Prompt,
        [AllowEmptyString()][string] $Default = '',
        [scriptblock] $Validate
    )

    while ($true) {
        $label = if ($Default) { "$Prompt [$Default]" } else { $Prompt }
        $answer = "$(Read-Host -Prompt $label)".Trim()
        if (-not $answer) { $answer = $Default }
        if (-not $answer) {
            Show-SetupMessage -Kind Warning -Message 'A value is required.'
            continue
        }
        if ($Validate) {
            $problem = & $Validate $answer
            if ($problem) {
                Show-SetupMessage -Kind Warning -Message ([string] $problem)
                continue
            }
        }
        return $answer
    }
}

function Confirm-SetupAction {
    [CmdletBinding()]
    [OutputType([bool])]
    param(
        [Parameter(Mandatory)][string] $Prompt,
        [switch] $DefaultYes
    )

    $suffix = if ($DefaultYes) { '[Y/n]' } else { '[y/N]' }
    while ($true) {
        $answer = "$(Read-Host -Prompt "$Prompt $suffix")".Trim().ToLowerInvariant()
        if (-not $answer) { return [bool] $DefaultYes }
        if ($answer -in @('y', 'yes', 'a', 'ano')) { return $true }
        if ($answer -in @('n', 'no', 'ne')) { return $false }
        Show-SetupMessage -Kind Warning -Message 'Answer y or n.'
    }
}

function Read-SetupChoice {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)][string] $Prompt,
        [Parameter(Mandatory)][System.Collections.IDictionary] $Choice,
        [string] $Default = ''
    )

    foreach ($key in $Choice.Keys) { Show-SetupMessage -Kind Info -Message "[$key] $($Choice[$key])" }
    while ($true) {
        $label = if ($Default) { "$Prompt [$Default]" } else { $Prompt }
        $answer = "$(Read-Host -Prompt $label)".Trim().ToLowerInvariant()
        if (-not $answer) { $answer = $Default }
        if ($answer -and $Choice.Contains($answer)) { return $answer }
        Show-SetupMessage -Kind Warning -Message "Choose one of: $(@($Choice.Keys) -join ', ')."
    }
}

#endregion

#region Stage runner

function Add-SetupStageResult {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string] $Id,
        [Parameter(Mandatory)][string] $Step,
        [Parameter(Mandatory)][string] $Title,
        [Parameter(Mandatory)][ValidateSet('Ok', 'Missing', 'Forbidden', 'Error', 'Skipped')][string] $Status,
        [AllowEmptyString()][string] $Detail = ''
    )

    $Setup.Stages[$Id] = [pscustomobject]@{ Step = $Step; Id = $Id; Title = $Title; Status = $Status; Detail = $Detail }
}

function Invoke-SetupStage {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string] $Id,
        [Parameter(Mandatory)][string] $Step,
        [Parameter(Mandatory)][string] $Title,
        [string[]] $Requires = @(),
        [Parameter(Mandatory)][string] $Handler
    )

    Show-SetupStageHeader -Step $Step -Title $Title
    $stageBlocked = @($Requires | Where-Object { -not $Setup.Stages.Contains($_) -or $Setup.Stages[$_].Status -ne 'Ok' })
    if ($stageBlocked.Count -gt 0) {
        $stageNames = @($stageBlocked | ForEach-Object { if ($Setup.Stages.Contains($_)) { "$($Setup.Stages[$_].Step) $($Setup.Stages[$_].Title)" } else { $_ } })
        $stageDetail = "Requires: $($stageNames -join '; ')."
        Show-SetupMessage -Kind Warning -Message "Skipped. $stageDetail"
        Add-SetupStageResult -Setup $Setup -Id $Id -Step $Step -Title $Title -Status Skipped -Detail $stageDetail
        return
    }
    while ($true) {
        $stageFailure = $null
        try {
            $stageOutput = @(& $Handler -Setup $Setup)
            $stageDetail = if ($stageOutput.Count -gt 0) { [string] $stageOutput[-1] } else { '' }
            Show-SetupMessage -Kind Ok -Message $(if ($stageDetail) { $stageDetail } else { 'Done.' })
            Add-SetupStageResult -Setup $Setup -Id $Id -Step $Step -Title $Title -Status Ok -Detail $stageDetail
            return
        }
        catch {
            $stageFailure = Get-SetupFailure -ErrorRecord $_
            if ($stageFailure.Quit) { throw }
        }
        Show-SetupMessage -Kind Error -Message "$($stageFailure.Status): $($stageFailure.Message)"
        Show-SetupGuidance -Line $stageFailure.Guidance
        $stageChoices = [ordered]@{ r = 'Retry this step' }
        if ($stageFailure.Area) { $stageChoices['l'] = "Sign in to $($stageFailure.Area) again, then retry" }
        $stageChoices['s'] = 'Skip this step and continue; dependent steps are skipped'
        $stageChoices['q'] = 'Quit; the next run repeats the checks and resumes'
        $stageAnswer = Read-SetupChoice -Prompt 'What next?' -Choice $stageChoices -Default 'r'
        if ($stageAnswer -eq 'l') {
            try {
                if ($stageFailure.Area -eq 'azure') { Invoke-SetupAzureLogin -Setup $Setup } else { Invoke-SetupGitHubLogin -Setup $Setup }
            }
            catch {
                $stageLoginFailure = Get-SetupFailure -ErrorRecord $_
                if ($stageLoginFailure.Quit) { throw }
                Show-SetupMessage -Kind Error -Message "Sign-in failed: $($stageLoginFailure.Message)"
            }
        }
        elseif ($stageAnswer -in @('s', 'q')) {
            Add-SetupStageResult -Setup $Setup -Id $Id -Step $Step -Title $Title -Status $stageFailure.Status -Detail $stageFailure.Message
            if ($stageAnswer -eq 'q') { Exit-SetupWizard }
            return
        }
    }
}

#endregion

#region Sign-in

function Get-SetupAzureToken {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][ValidateSet('graph.microsoft.com', 'management.azure.com')][string] $TokenHost
    )

    $cached = $Setup.AzureTokens[$TokenHost]
    if ($cached -and $cached.ExpiresOn -gt [DateTimeOffset]::UtcNow.AddMinutes(5)) { return $cached.Token }
    $tenantId = $Setup.Settings['tenantId']
    $text = & az account get-access-token --tenant $tenantId --resource "https://$TokenHost/" --output json --only-show-errors 2>&1 | Out-String
    if ($LASTEXITCODE -ne 0) {
        Exit-SetupStage -Status Missing -Area azure -Message "Azure CLI has no valid sign-in for tenant $tenantId." `
            -Guidance @("Choose [l] to sign in, or run: az login --tenant $tenantId")
    }
    try {
        $token = ConvertFrom-Json -InputObject $text -AsHashtable
    }
    catch {
        Exit-SetupStage -Status Error -Area azure -Message "Azure CLI returned an unreadable token response: $($_.Exception.Message)"
    }
    if ($token -isnot [System.Collections.IDictionary] -or $token['tenant'] -ne $tenantId -or [string]::IsNullOrWhiteSpace($token['accessToken'])) {
        Exit-SetupStage -Status Error -Area azure -Message "Azure CLI did not return a token for tenant $tenantId." `
            -Guidance @("Choose [l] to sign in, or run: az login --tenant $tenantId")
    }
    $expiresOn = if ($token['expires_on']) {
        [DateTimeOffset]::FromUnixTimeSeconds([long] $token['expires_on'])
    }
    else {
        [DateTimeOffset]::UtcNow.AddMinutes(10)
    }
    $Setup.AzureTokens[$TokenHost] = @{ Token = $token['accessToken']; ExpiresOn = $expiresOn }
    return $token['accessToken']
}

function Invoke-SetupAzureLogin {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $tenantId = $Setup.Settings['tenantId']
    $account = $Setup.Facts.Upn
    if ($account) {
        Show-SetupMessage -Kind Action -Message "Signing $account out of Azure CLI and in again to tenant $tenantId, so that Azure CLI issues new tokens. Choose your bootstrap account in the browser."
    }
    else {
        Show-SetupMessage -Kind Action -Message "Signing in to Azure tenant $tenantId. Choose your bootstrap account in the browser."
    }
    # The interactive subscription picker of newer Azure CLI versions would wait for hidden input.
    $previousExperience = $env:AZURE_CORE_LOGIN_EXPERIENCE_V2
    $env:AZURE_CORE_LOGIN_EXPERIENCE_V2 = 'off'
    try {
        if ($account) {
            # az login renews only the token for management.core.windows.net. Cached tokens for Graph and
            # management.azure.com would keep the directory roles from before a PIM activation until they expire.
            & az logout --username $account --only-show-errors 2>&1 | Out-Null
        }
        & az login --tenant $tenantId --only-show-errors | Out-Null
        $exitCode = $LASTEXITCODE
    }
    finally {
        $env:AZURE_CORE_LOGIN_EXPERIENCE_V2 = $previousExperience
    }
    $Setup.AzureTokens.Clear()
    if ($exitCode -ne 0) { Exit-SetupStage -Status Error -Area azure -Message 'az login failed.' }
}

function Get-SetupTokenClaim {
    [CmdletBinding()]
    [OutputType([System.Collections.IDictionary])]
    param([Parameter(Mandatory)][AllowEmptyString()][string] $Token)

    $parts = $Token.Split('.')
    if ($parts.Count -ne 3) { return $null }
    try {
        $payload = $parts[1].Replace('-', '+').Replace('_', '/')
        $payload += '=' * ((4 - $payload.Length % 4) % 4)
        $claims = ConvertFrom-Json -InputObject ([System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($payload))) -AsHashtable -ErrorAction Stop
    }
    catch {
        return $null
    }
    if ($claims -isnot [System.Collections.IDictionary]) { return $null }
    return $claims
}

function Format-SetupAzureTokenDetail {
    [CmdletBinding()]
    [OutputType([string])]
    param([Parameter(Mandatory)][AllowEmptyString()][string] $Token)

    # Only the issue time and the directory role claim are shown, never the token.
    $claims = Get-SetupTokenClaim -Token $Token
    $issuedAt = 0L
    if ($null -eq $claims -or -not [long]::TryParse([string] $claims['iat'], [ref] $issuedAt)) { return 'Azure token details are not readable.' }
    $issued = [DateTimeOffset]::FromUnixTimeSeconds($issuedAt)
    $age = [int] [Math]::Floor(([DateTimeOffset]::UtcNow - $issued).TotalMinutes)
    $roles = if (-not $claims.Contains('wids')) { 'it has no wids claim' }
    elseif (@($claims['wids']) -contains $script:RoleGlobalAdministrator) { 'its wids claim includes Global Administrator' }
    else { 'its wids claim does not include Global Administrator' }
    return "Azure token issued at $($issued.UtcDateTime.ToString('yyyy-MM-ddTHH:mm:ssZ')) ($age min ago); $roles."
}

function Get-SetupGitHubToken {
    [CmdletBinding()]
    [OutputType([string])]
    param([Parameter(Mandatory)][hashtable] $Setup)

    if ($Setup.GitHubToken) { return $Setup.GitHubToken }
    $githubHost = $Setup.Settings['githubHost']
    $text = (& gh auth token --hostname $githubHost 2>&1 | Out-String).Trim()
    if ($LASTEXITCODE -ne 0 -or -not $text) {
        Exit-SetupStage -Status Missing -Area github -Message "gh has no sign-in for $githubHost." `
            -Guidance @("Choose [l] to sign in, or run: gh auth login --hostname $githubHost --web --scopes read:enterprise")
    }
    if ($text -cnotmatch '^gho_[A-Za-z0-9_]+$') {
        Exit-SetupStage -Status Error -Area github -Message 'gh returned a token that is not an OAuth token (gho_). Bootstrap accepts only the gh OAuth sign-in.' `
            -Guidance @('Remove GH_TOKEN, GITHUB_TOKEN, GH_ENTERPRISE_TOKEN and GITHUB_ENTERPRISE_TOKEN, then choose [l].')
    }
    $Setup.GitHubToken = $text
    return $text
}

function Invoke-SetupGitHubLogin {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $githubHost = $Setup.Settings['githubHost']
    Show-SetupMessage -Kind Action -Message "Signing in to $githubHost with gh. Use your own enterprise owner account, not the setup user ending in _admin."
    & gh auth login --hostname $githubHost --web --git-protocol https --scopes read:enterprise | Out-Host
    $exitCode = $LASTEXITCODE
    $Setup.GitHubToken = $null
    if ($exitCode -ne 0) { Exit-SetupStage -Status Error -Area github -Message 'gh auth login failed.' }
}

function Get-SetupGitHubScope {
    [CmdletBinding()]
    [OutputType([string[]])]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $response = Invoke-SetupApi -Setup $Setup -Uri "https://api.$($Setup.Settings['githubHost'])/user"
    $null = Assert-SetupResponse -Response $response -Action 'Reading the gh token scopes'
    $header = $response.Headers['X-OAuth-Scopes']
    return @("$(@($header) -join ',')" -split ',' | ForEach-Object { $_.Trim() } | Where-Object { $_ })
}

function Test-SetupGitHubScope {
    [CmdletBinding()]
    [OutputType([bool])]
    param(
        [AllowEmptyCollection()][string[]] $Granted = @(),
        [Parameter(Mandatory)][string] $Scope
    )

    if ($Scope -in $Granted) { return $true }
    $parts = $Scope -split ':', 2
    if ($parts.Count -ne 2) { return $false }
    $covering = switch ($parts[0]) {
        'read' { @("write:$($parts[1])", "admin:$($parts[1])") }
        'write' { @("admin:$($parts[1])") }
        default { @() }
    }
    return @($covering | Where-Object { $_ -in $Granted }).Count -gt 0
}

function Add-SetupGitHubScope {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string[]] $Scope,
        [Parameter(Mandatory)][string] $Purpose,
        [switch] $Permanent
    )

    $granted = Get-SetupGitHubScope -Setup $Setup
    $missing = @($Scope | Where-Object { -not (Test-SetupGitHubScope -Granted $granted -Scope $_) })
    if ($missing.Count -eq 0) { return }
    $githubHost = $Setup.Settings['githubHost']
    $command = "gh auth refresh --hostname $githubHost --scopes $($missing -join ',')"
    $lifetime = if ($Permanent) { 'Bootstrap needs it later as well.' } else { 'The wizard offers to remove it at the end.' }
    Show-SetupMessage -Kind Action -Message "gh needs the OAuth scope $($missing -join ', ') for $Purpose. $lifetime"
    if (-not (Confirm-SetupAction -Prompt 'Request the scope now (browser confirmation follows)?' -DefaultYes)) {
        Exit-SetupStage -Status Missing -Area github -Message "The gh token lacks the scope $($missing -join ', ')." -Guidance @("Run: $command")
    }
    & gh auth refresh --hostname $githubHost --scopes ($missing -join ',') | Out-Host
    if ($LASTEXITCODE -ne 0) { Exit-SetupStage -Status Error -Area github -Message 'gh auth refresh failed.' -Guidance @("Run: $command") }
    $Setup.GitHubToken = $null
    $granted = Get-SetupGitHubScope -Setup $Setup
    $stillMissing = @($missing | Where-Object { -not (Test-SetupGitHubScope -Granted $granted -Scope $_) })
    if ($stillMissing.Count -gt 0) {
        Exit-SetupStage -Status Missing -Area github -Message "The gh token still lacks the scope $($stillMissing -join ', ')." -Guidance @("Run: $command")
    }
    if (-not $Permanent) {
        foreach ($name in $missing) { if ($name -notin $Setup.AddedScopes) { $Setup.AddedScopes.Add($name) } }
    }
}

