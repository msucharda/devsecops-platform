#region Stages A4-A5

function Invoke-StepEnterpriseApp {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $githubHost = $Setup.Settings['githubHost']
    $select = 'id,appId,displayName,preferredSingleSignOnMode,appRoles'
    $application = $null
    $spId = $Setup.Settings['enterpriseApplicationObjectId']
    if ($spId) {
        $application = Assert-SetupResponse -AllowMissing -Action 'Reading the EMU enterprise application' `
            -Response (Invoke-SetupApi -Setup $Setup -Uri "$script:Graph/servicePrincipals/$spId`?`$select=$select")
        if (-not $application) {
            Show-SetupMessage -Kind Warning -Message "Service principal $spId does not exist. Searching by name."
            $Setup.Settings['enterpriseApplicationObjectId'] = ''
        }
    }
    if (-not $application) {
        $filter = [uri]::EscapeDataString("displayName eq '$script:EmuApplicationName'")
        $candidates = @(Get-SetupCollection -Setup $Setup -Action 'Searching for the EMU enterprise application' `
            -Uri "$script:Graph/servicePrincipals?`$filter=$filter&`$select=$select")
        if ($candidates.Count -eq 0) {
            Exit-SetupStage -Status Missing -Message "The tenant has no enterprise application '$script:EmuApplicationName'." -Guidance @(
                "Sign in to https://$githubHost as the setup user <shortcode>_admin. Download the recovery codes and store them outside the work folder.",
                'Your enterprise > Identity provider > Single sign-on configuration > OIDC single sign-on > Require OIDC single sign-on > Save.',
                'GitHub redirects to Entra ID. A Global Administrator grants consent on behalf of the organization. Then choose [r].'
            )
        }
        $application = $candidates[0]
        if ($candidates.Count -gt 1) {
            $choice = [ordered]@{}
            for ($index = 0; $index -lt $candidates.Count; $index++) {
                $choice["$($index + 1)"] = "object ID $($candidates[$index]['id']), appId $($candidates[$index]['appId'])"
            }
            $application = $candidates[[int] (Read-SetupChoice -Prompt "Which application belongs to $githubHost?" -Choice $choice) - 1]
        }
    }
    $mode = $application['preferredSingleSignOnMode']
    if ($null -ne $mode -and $mode -ne 'oidc') {
        Exit-SetupStage -Status Error -Message "Service principal $($application['id']) uses SSO mode '$mode', not OIDC." `
            -Guidance @("Use the application '$script:EmuApplicationName' that GitHub created for OIDC SSO.")
    }
    $roles = @($application['appRoles'] | Where-Object { $_['isEnabled'] -eq $true -and 'User' -in $_['allowedMemberTypes'] })
    $ownerRoles = @($roles | Where-Object { $_['displayName'] -eq 'Enterprise Owner' })
    if ($ownerRoles.Count -ne 1) {
        Exit-SetupStage -Status Error -Message 'The EMU application must expose exactly one enabled Enterprise Owner app role for users.'
    }
    $userRoles = @($roles | Where-Object { $_['displayName'] -eq 'User' })
    $Setup.Facts.OwnerRoleId = $ownerRoles[0]['id']
    $Setup.Facts.UserRoleId = if ($userRoles.Count -eq 1) { $userRoles[0]['id'] } else { $null }
    $Setup.Facts.OidcModeVerified = $mode -eq 'oidc'
    $spId = [string] $application['id']
    $Setup.Settings['enterpriseApplicationObjectId'] = $spId
    $filter = [uri]::EscapeDataString("clientId eq '$spId' and consentType eq 'AllPrincipals'")
    $grants = Invoke-SetupApi -Setup $Setup -Uri "$script:Graph/oauth2PermissionGrants?`$filter=$filter"
    if ($grants.Status -eq 'Forbidden') {
        Show-SetupMessage -Kind Warning -Message 'Cannot read the admin consent of the application. The SCIM and owner steps verify the sign-in indirectly.'
    }
    else {
        $grantData = Assert-SetupResponse -Response $grants -Action 'Reading the admin consent of the application'
        if (@($grantData['value']).Count -eq 0) {
            Exit-SetupStage -Status Missing -Message 'The EMU application has no tenant-wide admin consent.' -Guidance @(
                "A Global Administrator signs in to https://$githubHost through Entra ID and grants consent on behalf of the organization,",
                "or opens Entra admin center > Enterprise applications > $script:EmuApplicationName > Permissions > Grant admin consent. Then choose [r]."
            )
        }
    }
    $modeText = if ($Setup.Facts.OidcModeVerified) { 'SSO mode oidc' } else { 'Graph does not report the SSO mode; the GitHub sign-in in A6 verifies OIDC' }
    return "Enterprise application $spId, $modeText."
}

function Get-SetupScimJob {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $spId = $Setup.Settings['enterpriseApplicationObjectId']
    $jobs = @(Get-SetupCollection -Setup $Setup -Uri "$script:Graph/servicePrincipals/$spId/synchronization/jobs" -Action 'Reading the SCIM provisioning jobs' `
        -Guidance @('Activate Application Administrator or Cloud Application Administrator in PIM, then choose [l].'))
    $preferred = @($jobs | Where-Object { $_['templateId'] -eq 'gitHubEnterpriseManagedUserOidc' })
    if ($preferred.Count -gt 0) { return $preferred[0] }
    if ($jobs.Count -gt 0) { return $jobs[0] }
}

function Invoke-StepScim {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $githubHost = $Setup.Settings['githubHost']
    $enterprise = $Setup.Settings['enterprise']
    $guidance = @(
        "As the setup user, create a classic PAT with the scope scim:enterprise and no expiration: https://$githubHost/settings/tokens/new",
        "Entra admin center > Enterprise applications > $script:EmuApplicationName > Provisioning:",
        "Provisioning Mode = Automatic, Tenant URL = https://api.$githubHost/scim/v2/enterprises/$enterprise, Secret Token = the PAT.",
        'Test Connection > Save > Provisioning Status = On > Save. Then choose [r].'
    )
    $job = Get-SetupScimJob -Setup $Setup
    if (-not $job) { Exit-SetupStage -Status Missing -Message 'The EMU application has no SCIM provisioning job.' -Guidance $guidance }
    $schedule = if ($job['schedule'] -is [System.Collections.IDictionary]) { [string] $job['schedule']['state'] } else { '' }
    $status = if ($job['status'] -is [System.Collections.IDictionary]) { [string] $job['status']['code'] } else { '' }
    if ($status -eq 'Quarantine') {
        $reason = if ($job['status']['quarantine'] -is [System.Collections.IDictionary]) { " ($($job['status']['quarantine']['reason']))" } else { '' }
        Exit-SetupStage -Status Error -Message "The SCIM job is in quarantine$reason. It does not synchronize changes from Entra ID." -Guidance (
            @('A wrong Secret Token or Tenant URL usually causes quarantine. Fix them, then Provisioning > Restart provisioning.') + $guidance)
    }
    if ($schedule -ne 'Active' -or $status -ne 'Active') {
        Show-SetupMessage -Kind Warning -Message "The SCIM job has schedule '$schedule' and status '$status'."
        $startGuidance = @("Entra admin center > Enterprise applications > $script:EmuApplicationName > Provisioning > Start provisioning. Then choose [r].")
        if (-not (Confirm-SetupAction -Prompt 'Start the SCIM provisioning job now?' -DefaultYes)) {
            Exit-SetupStage -Status Missing -Message 'Bootstrap needs an active SCIM provisioning job.' -Guidance $startGuidance
        }
        $response = Invoke-SetupApi -Setup $Setup -Method POST -Uri "$script:Graph/servicePrincipals/$($Setup.Settings['enterpriseApplicationObjectId'])/synchronization/jobs/$($job['id'])/start"
        $null = Assert-SetupResponse -Response $response -Action 'Starting the SCIM job' -Guidance $startGuidance
        $active = Wait-SetupCondition -TimeoutSeconds 120 -IntervalSeconds 10 -Activity 'Waiting for the SCIM job' -Condition {
            $scimJob = Get-SetupScimJob -Setup $Setup
            if ($scimJob -and $scimJob['schedule'] -is [System.Collections.IDictionary] -and $scimJob['status'] -is [System.Collections.IDictionary] -and
                $scimJob['schedule']['state'] -eq 'Active' -and $scimJob['status']['code'] -eq 'Active') { $true }
        }
        if (-not $active) { Exit-SetupStage -Status Missing -Message 'The SCIM job did not become active within 2 minutes.' -Guidance $startGuidance }
    }
    $Setup.Facts.ScimJobId = [string] $job['id']
    return "SCIM job $($job['templateId']) has an active schedule and status."
}

function Invoke-SetupProvisionOnDemand {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $spId = $Setup.Settings['enterpriseApplicationObjectId']
    $jobId = $Setup.Facts.ScimJobId
    $portal = "Entra admin center > Enterprise applications > $script:EmuApplicationName > Provisioning > Provision on demand > select $($Setup.Facts.Upn)."
    if (-not $jobId) {
        Show-SetupMessage -Kind Warning -Message 'No active SCIM job is known. Provision your user manually after the SCIM step:'
        Show-SetupGuidance -Line @($portal)
        return
    }
    if (-not (Confirm-SetupAction -Prompt 'Provision your user to GitHub now instead of waiting up to 40 minutes for the SCIM cycle?' -DefaultYes)) { return }
    $schema = Invoke-SetupApi -Setup $Setup -Uri "$script:Graph/servicePrincipals/$spId/synchronization/jobs/$jobId/schema"
    $rules = if ($schema.Status -eq 'Ok' -and $schema.Data -is [System.Collections.IDictionary]) { @($schema.Data['synchronizationRules']) } else { @() }
    if ($rules.Count -eq 0) {
        Show-SetupMessage -Kind Warning -Message "Cannot read the SCIM schema. $($schema.Message)"
        Show-SetupGuidance -Line @($portal)
        return
    }
    $userRules = @($rules | Where-Object {
            $_ -is [System.Collections.IDictionary] -and @($_['objectMappings'] | Where-Object {
                    $_ -is [System.Collections.IDictionary] -and $_['enabled'] -ne $false -and $_['sourceObjectName'] -eq 'User'
                }).Count -gt 0
        })
    if ($userRules.Count -eq 0) {
        Show-SetupMessage -Kind Warning -Message 'The SCIM schema has no enabled rule for users.'
        Show-SetupGuidance -Line @($portal)
        return
    }
    $body = @{ parameters = @(@{ ruleId = $userRules[0]['id']; subjects = @(@{ objectId = $Setup.Facts.Me; objectTypeName = 'User' }) }) }
    $response = Invoke-SetupApi -Setup $Setup -Method POST -Uri "$script:Graph/servicePrincipals/$spId/synchronization/jobs/$jobId/provisionOnDemand" -Body $body
    if ($response.Status -ne 'Ok') {
        Show-SetupMessage -Kind Warning -Message "Provision on demand failed. $($response.Message)"
        Show-SetupGuidance -Line @($portal)
        return
    }
    $result = Get-SetupProvisionResult -Data $response.Data -ObjectId $Setup.Facts.Me
    if ($result.Status -eq 'Success') {
        Show-SetupMessage -Kind Ok -Message 'Provision on demand finished. Your EMU account exists in GitHub.'
        return
    }
    if ($result.Status -eq 'Skipped' -and $result.ErrorCode -eq 'RedundantExport') {
        Show-SetupMessage -Kind Ok -Message 'Provision on demand skipped the export: your EMU account in GitHub already matches Entra ID.'
        return
    }
    if (-not $result.Status) {
        Show-SetupMessage -Kind Warning -Message 'Cannot read the provisioning result. Check it in the portal:'
    }
    else {
        $reason = (@($result.ErrorCode, $result.ErrorMessage) | Where-Object { $_ }) -join ': '
        $message = "Provision on demand returned $($result.Status). $reason"
        Show-SetupMessage -Kind Warning -Message $message.TrimEnd()
    }
    Show-SetupGuidance -Line @($portal)
}

function Get-SetupProvisionResult {
    [CmdletBinding()]
    [OutputType([hashtable])]
    param(
        [AllowNull()] $Data,
        [Parameter(Mandatory)][string] $ObjectId
    )

    # Graph documents key and value as JSON strings. The live service returned a .NET type name in key and a JSON array
    # of provisioning records in value, so only records for the requested user with a target identity count as success.
    $result = @{ Status = $null; ErrorCode = $null; ErrorMessage = $null }
    if ($Data -isnot [System.Collections.IDictionary]) { return $result }
    $parse = {
        param($Text)
        if ($Text -isnot [string]) { return }
        try { ConvertFrom-Json -InputObject $Text -AsHashtable -NoEnumerate -ErrorAction Stop } catch { $null = $_ }
    }
    $summary = & $parse $Data['key']
    if ($summary -isnot [System.Collections.IDictionary]) { $summary = @{} }
    $parsedValue = & $parse $Data['value']
    $records = @(@($parsedValue) | Where-Object { $_ -is [System.Collections.IDictionary] })
    $sourceOf = { param($Record) if ($Record['sourceIdentity'] -is [System.Collections.IDictionary]) { [string] $Record['sourceIdentity']['id'] } }
    $identified = @($records | Where-Object { & $sourceOf $_ })
    if ($identified.Count -gt 0) { $records = @($identified | Where-Object { (& $sourceOf $_) -eq $ObjectId }) }
    if ($records.Count -eq 0) { return $result }
    $statusOf = {
        param($Record)
        $own = if ($Record['statusInfo'] -is [System.Collections.IDictionary]) { [string] $Record['statusInfo']['status'] }
        if ($own) { $own } elseif ($summary['result']) { [string] $summary['result'] }
    }
    $failed = @($records | Where-Object { (& $statusOf $_) -eq 'Failure' })
    $exported = @($records | Where-Object {
            (& $statusOf $_) -eq 'Success' -and (& $sourceOf $_) -eq $ObjectId -and
            $_['targetIdentity'] -is [System.Collections.IDictionary] -and $_['targetIdentity']['id']
        })
    $record = if ($failed.Count -gt 0) { $failed[0] } elseif ($exported.Count -gt 0) { $exported[0] } else { $records[0] }
    $status = & $statusOf $record
    if (-not $status -or ($status -eq 'Success' -and $exported.Count -eq 0)) { return $result }
    $result.Status = $status
    $info = if ($record['statusInfo'] -is [System.Collections.IDictionary]) { $record['statusInfo'] } else { @{} }
    $details = if ($summary['details'] -is [System.Collections.IDictionary]) { $summary['details'] } else { @{} }
    $skipReason = @($record['provisioningSteps'] | Where-Object {
            $_ -is [System.Collections.IDictionary] -and $_['status'] -eq 'Skipped' -and $_['details'] -is [System.Collections.IDictionary]
        } | ForEach-Object { $_['details']['SkipReason'] } | Where-Object { $_ }) | Select-Object -First 1
    $result.ErrorCode = @($info['errorCode'], $skipReason, $details['errorCode']) | Where-Object { $_ } | Select-Object -First 1
    $result.ErrorMessage = @($info['reason'], $details['errorMessage']) | Where-Object { $_ } | Select-Object -First 1
    return $result
}

function Invoke-StepOwnerAssignment {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $spId = $Setup.Settings['enterpriseApplicationObjectId']
    $me = $Setup.Facts.Me
    $portal = @("Entra admin center > Enterprise applications > $script:EmuApplicationName > Users and groups > Add user/group: select your user, not a group, role Enterprise Owner > Assign.")
    $assignments = @(Get-SetupCollection -Setup $Setup -Uri "$script:Graph/servicePrincipals/$spId/appRoleAssignedTo" -Action 'Reading the app role assignments')
    $direct = @($assignments | Where-Object {
        $_['principalId'] -eq $me -and $_['principalType'] -eq 'User' -and $_['appRoleId'] -eq $Setup.Facts.OwnerRoleId
    })
    if ($direct.Count -gt 0) { return "$($Setup.Facts.Upn) has a direct Enterprise Owner assignment." }
    Show-SetupMessage -Kind Warning -Message "$($Setup.Facts.Upn) has no direct Enterprise Owner assignment. Bootstrap does not accept an assignment through a group."
    if (-not (Confirm-SetupAction -Prompt 'Assign the Enterprise Owner app role to your user now?' -DefaultYes)) {
        Exit-SetupStage -Status Missing -Message 'Bootstrap needs a direct Enterprise Owner assignment.' -Guidance $portal
    }
    $response = Invoke-SetupApi -Setup $Setup -Method POST -Uri "$script:Graph/servicePrincipals/$spId/appRoleAssignedTo" `
        -Body @{ principalId = $me; resourceId = $spId; appRoleId = $Setup.Facts.OwnerRoleId }
    $null = Assert-SetupResponse -Response $response -Action 'Assigning the Enterprise Owner app role' -Guidance (@(
        'Assigning app roles needs Application Administrator, Cloud Application Administrator or Global Administrator.',
        'Activate the role in PIM, then choose [l]. Or assign the role in the portal:'
    ) + $portal)
    Show-SetupMessage -Kind Ok -Message 'Enterprise Owner assigned.'
    Invoke-SetupProvisionOnDemand -Setup $Setup
    return "$($Setup.Facts.Upn) has a direct Enterprise Owner assignment."
}

