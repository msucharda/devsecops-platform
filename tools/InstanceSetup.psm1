#region Stage A3

function Invoke-StepSubscription {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $tenantId = $Setup.Settings['tenantId']
    $guidance = @(
        'Check the subscription ID in Azure portal > Subscriptions. Your account needs at least Reader on it.',
        'Quit and rerun the wizard to correct the inputs, or choose [r] after the fix.'
    )
    $rows = foreach ($subscriptionId in $Setup.Settings['subscriptionIds']) {
        $response = Invoke-SetupApi -Setup $Setup -Uri "$script:Arm/subscriptions/$subscriptionId`?api-version=2022-12-01"
        $subscription = Assert-SetupResponse -Response $response -Action "Reading subscription $subscriptionId" -Guidance $guidance
        if ($subscription['tenantId'] -ne $tenantId) {
            Exit-SetupStage -Status Error -Message "Subscription $subscriptionId belongs to tenant $($subscription['tenantId']), not $tenantId." -Guidance $guidance
        }
        if ($subscription['state'] -ne 'Enabled') {
            Exit-SetupStage -Status Error -Message "Subscription $subscriptionId is $($subscription['state']). Bootstrap needs an enabled subscription." -Guidance $guidance
        }
        [pscustomobject]@{ Subscription = $subscription['displayName']; Id = $subscriptionId; State = $subscription['state'] }
    }
    Show-SetupTable -Row @($rows)
    $locations = @(Get-SetupCollection -Setup $Setup -Action 'Reading Azure regions' `
        -Uri "$script:Arm/subscriptions/$($Setup.Settings['managementSubscriptionId'])/locations?api-version=2022-12-01")
    $regionNames = @($locations | ForEach-Object { [string] $_['name'] })
    if ($Setup.Settings['region'] -notin $regionNames) {
        Show-SetupMessage -Kind Warning -Message "Region '$($Setup.Settings['region'])' is not available in the management subscription."
        $Setup.Settings['region'] = Read-SetupValue -Prompt 'Azure region' -Validate {
            param($text)
            if ($text -notin $regionNames) { "Unknown region. Examples: $(@($regionNames | Select-Object -First 8) -join ', ')." }
        }
    }
    return "$(@($rows).Count) subscription(s) are enabled in tenant $tenantId. Region $($Setup.Settings['region']) is available."
}

function Get-SetupOwnerGap {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    foreach ($subscriptionId in $Setup.Settings['subscriptionIds']) {
        $scope = "/subscriptions/$subscriptionId"
        if (@(Get-SetupMissingAction -Setup $Setup -Scope $scope -Operation $script:BootstrapActions).Count -gt 0) { $scope }
    }
}

function Invoke-StepAzureOwner {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $count = @($Setup.Settings['subscriptionIds']).Count
    $ownerGaps = @(Get-SetupOwnerGap -Setup $Setup)
    if ($ownerGaps.Count -eq 0) { return "Your account has the Owner actions bootstrap needs in $count subscription(s)." }
    Show-SetupMessage -Kind Warning -Message "Your account lacks the Owner actions bootstrap needs at: $($ownerGaps -join ', ')."
    $me = $Setup.Facts.Me
    $adminGuidance = @($ownerGaps | ForEach-Object {
        "az role assignment create --assignee-object-id $me --assignee-principal-type User --role Owner --scope $_"
    })
    Invoke-SetupElevatedAction -Setup $Setup -Purpose 'Assigning Owner on the subscriptions' -AdminGuidance $adminGuidance -Action {
        foreach ($ownerScope in $ownerGaps) { Invoke-SetupRoleAssignment -Setup $Setup -Scope $ownerScope -RoleId $script:RoleOwner }
    }
    $effective = Wait-SetupCondition -TimeoutSeconds 600 -IntervalSeconds 15 -Activity 'Waiting for the Owner role to take effect' -Condition {
        if (@(Get-SetupOwnerGap -Setup $Setup).Count -eq 0) { $true }
    }
    if (-not $effective) {
        Exit-SetupStage -Status Missing -Area azure -Message 'The Owner role is assigned but not effective yet.' `
            -Guidance @('Azure role assignments can take up to 10 minutes. Choose [r] later.')
    }
    return "Owner assigned and effective in $count subscription(s)."
}

function Get-SetupProviderState {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string] $SubscriptionId,
        [Parameter(Mandatory)][string] $Namespace
    )

    $response = Invoke-SetupApi -Setup $Setup -Uri "$script:Arm/subscriptions/$SubscriptionId/providers/$Namespace`?api-version=2021-04-01"
    $provider = Assert-SetupResponse -Response $response -Action "Reading resource provider $Namespace in subscription $SubscriptionId"
    return [string] $provider['registrationState']
}

function Invoke-StepResourceProvider {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $pending = @(foreach ($subscriptionId in $Setup.Settings['subscriptionIds']) {
        foreach ($namespace in $script:ResourceProviders) {
            $state = Get-SetupProviderState -Setup $Setup -SubscriptionId $subscriptionId -Namespace $namespace
            if ($state -ne 'Registered') { [pscustomobject]@{ Subscription = $subscriptionId; Provider = $namespace; State = $state } }
        }
    })
    $summary = "$($script:ResourceProviders -join ', ') are registered in $(@($Setup.Settings['subscriptionIds']).Count) subscription(s)."
    if ($pending.Count -eq 0) { return $summary }
    Show-SetupTable -Row $pending
    $commands = @($pending | ForEach-Object { "az provider register --subscription $($_.Subscription) --namespace $($_.Provider) --wait" })
    if (-not (Confirm-SetupAction -Prompt "Register $($pending.Count) resource provider(s) now?" -DefaultYes)) {
        Exit-SetupStage -Status Missing -Message 'Bootstrap needs the resource providers registered.' -Guidance $commands
    }
    foreach ($item in $pending) {
        if ($item.State -eq 'Registering') { continue }
        $response = Invoke-SetupApi -Setup $Setup -Method POST `
            -Uri "$script:Arm/subscriptions/$($item.Subscription)/providers/$($item.Provider)/register?api-version=2021-04-01"
        $null = Assert-SetupResponse -Response $response -Action "Registering $($item.Provider) in subscription $($item.Subscription)" `
            -Guidance @('Registration needs Contributor or Owner on the subscription. Fix the Owner step first.')
    }
    $registered = Wait-SetupCondition -TimeoutSeconds 600 -IntervalSeconds 15 -Activity 'Waiting for resource provider registration' -Condition {
        $providerOpen = @($pending | Where-Object {
            (Get-SetupProviderState -Setup $Setup -SubscriptionId $_.Subscription -Namespace $_.Provider) -ne 'Registered'
        })
        if ($providerOpen.Count -eq 0) { $true }
    }
    if (-not $registered) {
        Exit-SetupStage -Status Missing -Message 'Resource provider registration did not finish within 10 minutes.' -Guidance @('Choose [r] later.')
    }
    return $summary
}

function Test-SetupBootstrapTag {
    [CmdletBinding()]
    [OutputType([bool])]
    param(
        $Actual,
        [Parameter(Mandatory)][hashtable] $Expected
    )

    if ($Actual -isnot [System.Collections.IDictionary]) { return $false }
    return @($Expected.Keys | Where-Object { $Actual[$_] -ne $Expected[$_] }).Count -eq 0
}

function Get-SetupStateBackendProblem {
    [CmdletBinding()]
    [OutputType([string])]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $name = $Setup.Settings['name']
    $managementScope = "/subscriptions/$($Setup.Settings['managementSubscriptionId'])"
    $resourceGroupName = "rg-$name-bootstrap"
    $storageAccountName = "st$($name)tfstate"
    $resourceGroupId = "$managementScope/resourceGroups/$resourceGroupName"
    $tags = @{ platformInstance = $name; platformComponent = 'bootstrap' }
    $resourceGroup = Assert-SetupResponse -AllowMissing -Action "Reading resource group $resourceGroupName" `
        -Response (Invoke-SetupApi -Setup $Setup -Uri "$script:Arm$resourceGroupId`?api-version=2022-09-01")
    if ($resourceGroup -and -not (Test-SetupBootstrapTag -Actual $resourceGroup['tags'] -Expected $tags)) {
        return "Resource group $resourceGroupName exists without the bootstrap tags of instance $name. Bootstrap refuses to adopt it."
    }
    $storageAccount = $null
    if ($resourceGroup) {
        $storageAccount = Assert-SetupResponse -AllowMissing -Action "Reading storage account $storageAccountName" `
            -Response (Invoke-SetupApi -Setup $Setup -Uri "$script:Arm$resourceGroupId/providers/Microsoft.Storage/storageAccounts/$storageAccountName`?api-version=2023-05-01")
    }
    if ($storageAccount) {
        if (-not (Test-SetupBootstrapTag -Actual $storageAccount['tags'] -Expected $tags)) {
            return "Storage account $storageAccountName exists without the bootstrap tags of instance $name. Bootstrap refuses to adopt it."
        }
        return ''
    }
    $availability = Assert-SetupResponse -Action "Checking the storage account name $storageAccountName" -Response (
        Invoke-SetupApi -Setup $Setup -Method POST -Body @{ name = $storageAccountName; type = 'Microsoft.Storage/storageAccounts' } `
            -Uri "$script:Arm$managementScope/providers/Microsoft.Storage/checkNameAvailability?api-version=2023-05-01")
    if ($availability['nameAvailable'] -ne $true) {
        return "Storage account name $storageAccountName is not available ($($availability['reason'])). Storage account names are global in Azure."
    }
    return ''
}

function Invoke-StepStateBackend {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    while ($true) {
        $backendProblem = Get-SetupStateBackendProblem -Setup $Setup
        $name = $Setup.Settings['name']
        if (-not $backendProblem) {
            return "Resource group rg-$name-bootstrap and storage account st$($name)tfstate are free or belong to instance $name."
        }
        Show-SetupMessage -Kind Warning -Message $backendProblem
        if (-not (Confirm-SetupAction -Prompt 'Choose another instance name?' -DefaultYes)) {
            Exit-SetupStage -Status Error -Message $backendProblem -Guidance @('Rerun the wizard with another instance name.')
        }
        $Setup.Settings['name'] = Read-SetupValue -Prompt 'Instance name (2-8 lowercase letters and digits)' -Validate {
            param($text)
            Get-SetupInputProblem -Name 'name' -Value $text
        }
    }
}

function Get-SetupBackfillStatus {
    [CmdletBinding()]
    [OutputType([string])]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $response = Invoke-SetupApi -Setup $Setup -Method POST -Uri "$script:Arm/providers/Microsoft.Management/tenantBackfillStatus?api-version=2020-05-01"
    $data = $response.Data
    if ($response.Status -ne 'Ok' -or $data -isnot [System.Collections.IDictionary]) { return '' }
    if ($data['status']) { return [string] $data['status'] }
    if ($data['properties'] -is [System.Collections.IDictionary]) { return [string] $data['properties']['status'] }
    return ''
}

function Get-SetupManagementGroupProblem {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $tenantId = $Setup.Settings['tenantId']
    $checked = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
    foreach ($subscriptionId in $Setup.Settings['subscriptionIds']) {
        $filter = [uri]::EscapeDataString("name eq '$subscriptionId'")
        $response = Invoke-SetupApi -Setup $Setup -Method POST -Uri "$script:Arm/providers/Microsoft.Management/getEntities?api-version=2020-05-01&`$filter=$filter"
        if ($response.Status -ne 'Ok' -or $response.Data -isnot [System.Collections.IDictionary]) {
            "Cannot read the management-group ancestors of subscription $subscriptionId. $($response.Message)"
            continue
        }
        $entities = @($response.Data['value'] | Where-Object { $_['name'] -eq $subscriptionId -and $_['type'] -eq '/subscriptions' })
        $chain = if ($entities.Count -eq 1 -and $entities[0]['properties'] -is [System.Collections.IDictionary]) { $entities[0]['properties']['parentNameChain'] }
        if ($chain -isnot [System.Collections.IList] -or $chain.Count -eq 0 -or $chain[0] -ne $tenantId) {
            "Subscription $subscriptionId shows no complete management-group chain to the tenant root group."
            continue
        }
        foreach ($group in $chain) {
            if ($group -isnot [string] -or $group -notmatch '^[A-Za-z0-9_.()-]+$') {
                "Subscription $subscriptionId has an invalid management-group ancestor."
                continue
            }
            if (-not $checked.Add($group)) { continue }
            $groupScope = "/providers/Microsoft.Management/managementGroups/$group"
            $read = Invoke-SetupApi -Setup $Setup -Uri "$script:Arm$groupScope/providers/Microsoft.Authorization/roleAssignments?api-version=2022-04-01&`$filter=atScope()"
            if ($read.Status -ne 'Ok') { "Cannot read role assignments at management group $group." }
        }
    }
}

function Invoke-StepManagementGroup {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $tenantId = $Setup.Settings['tenantId']
    $portalGuidance = @('Open Azure portal > Management groups once. Azure then creates the Tenant Root Group. Choose [r] afterwards.')
    $backfill = Get-SetupBackfillStatus -Setup $Setup
    if ($backfill -in @('NotStarted', 'NotStartedButGroupsExist', 'Failed', 'Cancelled')) {
        Show-SetupMessage -Kind Warning -Message "The tenant has not finished setting up management groups (status $backfill)."
        if (-not (Confirm-SetupAction -Prompt 'Start the management-group setup (Tenant Root Group) now?' -DefaultYes)) {
            Exit-SetupStage -Status Missing -Message 'Bootstrap needs the Tenant Root Group.' -Guidance $portalGuidance
        }
        $response = Invoke-SetupApi -Setup $Setup -Method POST -Uri "$script:Arm/providers/Microsoft.Management/startTenantBackfill?api-version=2020-05-01"
        $null = Assert-SetupResponse -Response $response -Action 'Starting the management-group setup' -Guidance $portalGuidance
        $backfill = 'Started'
    }
    if ($backfill -eq 'Started') {
        $completed = Wait-SetupCondition -TimeoutSeconds 900 -IntervalSeconds 20 -Activity 'Waiting for the Tenant Root Group' -Condition {
            if ((Get-SetupBackfillStatus -Setup $Setup) -eq 'Completed') { $true }
        }
        if (-not $completed) { Exit-SetupStage -Status Missing -Message 'The management-group setup did not finish within 15 minutes.' -Guidance @('Choose [r] later.') }
    }
    $groupProblems = @(Get-SetupManagementGroupProblem -Setup $Setup)
    $summary = 'Every subscription has a readable management-group chain to the tenant root group.'
    if ($groupProblems.Count -eq 0) { return $summary }
    foreach ($line in $groupProblems) { Show-SetupMessage -Kind Warning -Message $line }
    $rootScope = "/providers/Microsoft.Management/managementGroups/$tenantId"
    if ((Invoke-SetupApi -Setup $Setup -Uri "$script:Arm$rootScope`?api-version=2020-05-01").Status -eq 'Ok') {
        Exit-SetupStage -Status Error -Message 'You can read the tenant root group, but the subscription chain is incomplete.' -Guidance @(
            'Azure portal > Management groups: every subscription must sit under the Tenant Root Group.',
            'Changes in the hierarchy can take up to 30 minutes. Choose [r] later.'
        )
    }
    $me = $Setup.Facts.Me
    Invoke-SetupElevatedAction -Setup $Setup -Purpose 'Assigning Management Group Reader on the tenant root group' -AdminGuidance @(
        "az role assignment create --assignee-object-id $me --assignee-principal-type User --role 'Management Group Reader' --scope $rootScope"
    ) -Action {
        Invoke-SetupRoleAssignment -Setup $Setup -Scope $rootScope -RoleId $script:RoleManagementGroupReader
    }
    $readable = Wait-SetupCondition -TimeoutSeconds 600 -IntervalSeconds 20 -Activity 'Waiting for Management Group Reader to take effect' -Condition {
        if (@(Get-SetupManagementGroupProblem -Setup $Setup).Count -eq 0) { $true }
    }
    if (-not $readable) {
        Exit-SetupStage -Status Missing -Area azure -Message 'Management Group Reader is assigned but not effective yet.' `
            -Guidance @('Azure role assignments can take up to 10 minutes. Choose [r] later.')
    }
    return $summary
}

