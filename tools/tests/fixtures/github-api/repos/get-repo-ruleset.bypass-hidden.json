  "source": {
    "operation": "GET /repos/{owner}/{repo}/rulesets/{ruleset_id}",
    "operationId": "repos/get-repo-ruleset",
    "documentation": "https://docs.github.com/en/enterprise-cloud@latest/rest/repos/rules#get-a-repository-ruleset",
    "apiVersion": "2026-03-10",
    "description": "https://github.com/github/rest-api-description/blob/bb754941722779d8a5b3a2f25a5fbb7ce794e1ea/descriptions/ghec/ghec.2026-03-10.json",
    "status": 200,
    "schema": "#/components/schemas/repository-ruleset",
    "note": "Primary example with bypass_actors omitted under the documented no-write-access response variant. API-valid omission is not an empty list; trusted preflight must reject missing visibility."
  },
  "required": {
    "": [
      "id",
      "name",
      "source",
      "enforcement"
    ]
  },
  "body": {
    "id": 42,
    "name": "super cool ruleset",
    "target": "branch",
    "source_type": "Repository",
    "source": "monalisa/my-repo",
    "enforcement": "active",
    "conditions": {
      "ref_name": {
        "include": [
          "refs/heads/main",
          "refs/heads/master"
        ],
        "exclude": [
          "refs/heads/dev*"
        ]
      }
    },
    "rules": [
      {
        "type": "commit_author_email_pattern",
        "parameters": {
          "operator": "contains",
          "pattern": "github"
        }
      }
    ],
    "node_id": "RRS_lACkVXNlcgQB",
    "_links": {
