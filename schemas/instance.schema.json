{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Instance configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["instance", "regions", "teams", "modules"],
  "properties": {
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8,
          "pattern": "^[a-z][a-z0-9]*$"
        }
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": { "$ref": "#/definitions/region" },
        "secondary": { "$ref": "#/definitions/region" }
      }
    },
    "teams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "security"],
      "properties": {
        "platform": { "$ref": "#/definitions/team" },
        "security": { "$ref": "#/definitions/team" }
      }
    },
    "modules": {
      "type": "object",
      "propertyNames": { "$ref": "module.schema.json#/definitions/moduleName" },
      "properties": {
        "organizations": {
          "allOf": [
            { "$ref": "#/definitions/moduleEntry" },
            {
              "required": ["parameters"],
              "properties": {
                "parameters": { "$ref": "#/definitions/organizationsParameters" }
              }
            }
          ]
        }
      },
      "additionalProperties": { "$ref": "#/definitions/moduleEntry" }
    },
    "manualPrerequisites": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant": { "$ref": "#/definitions/confirmation" },
        "enterpriseOidc": { "$ref": "#/definitions/confirmation" },
        "enterpriseScim": { "$ref": "#/definitions/confirmation" },
        "enterpriseOwner": { "$ref": "#/definitions/confirmation" },
        "subscriptions": { "$ref": "#/definitions/confirmation" },
        "licenses": { "$ref": "#/definitions/confirmation" },
        "privateInternalForksDisabled": { "$ref": "#/definitions/confirmation" },
        "repositoryManagementPoliciesEnforced": { "$ref": "#/definitions/confirmation" },
        "emuUserNamespacesRestricted": { "$ref": "#/definitions/confirmation" },
        "fineGrainedPatApprovalRequired": { "$ref": "#/definitions/confirmation" },
        "patMaxLifetime90Days": { "$ref": "#/definitions/confirmation" },
        "githubAppAvailabilityVerified": { "$ref": "#/definitions/confirmation" },
        "organizationSecurityTeamsLinked": { "$ref": "#/definitions/confirmation" },
        "liveWorkflowsPromoted": { "$ref": "#/definitions/confirmation" }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "managementSubscriptionId", "subscriptionIds", "enterpriseApplicationObjectId", "githubHost", "enterprise"],
      "properties": {
        "tenantId": { "$ref": "#/definitions/uuid" },
        "managementSubscriptionId": { "$ref": "#/definitions/uuid" },
        "subscriptionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/uuid" }
        },
        "enterpriseApplicationObjectId": { "$ref": "#/definitions/uuid" },
        "githubHost": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.ghe\\.com$"
        },
        "enterprise": { "$ref": "module.schema.json#/definitions/moduleName" }
      }
    },
    "manualSteps": {
      "type": "object",
      "propertyNames": { "$ref": "module.schema.json#/definitions/moduleName" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "module.schema.json#/definitions/moduleName" },
        "additionalProperties": { "$ref": "#/definitions/confirmation" }
      }
    },
    "customPatterns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "secretRegex"],
        "properties": {
          "name": { "$ref": "module.schema.json#/definitions/nonBlankString" },
          "secretRegex": { "$ref": "module.schema.json#/definitions/nonBlankString" },
          "beforeSecret": { "type": "string" },
          "afterSecret": { "type": "string" }
        }
      }
    },
    "githubApps": {
      "type": "object",
      "propertyNames": { "$ref": "module.schema.json#/definitions/moduleName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "installationId", "enterprise", "permissions", "resources"],
        "properties": {
          "appId": { "$ref": "#/definitions/githubId" },
          "installationId": { "$ref": "#/definitions/githubId" },
          "enterprise": { "$ref": "module.schema.json#/definitions/moduleName" },
          "permissions": { "$ref": "module.schema.json#/definitions/githubAppPermissions" },
          "resources": { "$ref": "module.schema.json#/definitions/githubAppResources" }
        }
      }
    },
    "credentials": {
      "type": "object",
      "propertyNames": { "$ref": "module.schema.json#/definitions/moduleName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plan", "apply"],
        "properties": {
          "plan": { "$ref": "#/definitions/credentialBinding" },
          "apply": { "$ref": "#/definitions/credentialBinding" },
          "rulesetPlan": { "$ref": "#/definitions/credentialBinding" }
        }
      }
    },
    "teardown": {
      "type": "object",
      "additionalProperties": false,
      "default": { "allowed": false },
      "properties": {
        "allowed": { "type": "boolean", "default": false }
      }
    }
  },
  "definitions": {
    "moduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "type": "object",
          "propertyNames": {
            "allOf": [
              { "$ref": "#/definitions/parameterName" },
              { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              {
                "not": {
                  "pattern": "^([Ii][Nn][Ss][Tt][Aa][Nn][Cc][Ee]|[Pp][Rr][Ee][Rr][Ee][Qq][Uu][Ii][Ss][Ii][Tt][Ee][Ss])$"
                }
              }
            ]
          },
          "additionalProperties": { "$ref": "#/definitions/parameterValue" }
        }
      }
    },
    "organizationsParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admin_logins", "billing_email"],
      "properties": {
        "admin_logins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/emuLogin" }
        },
        "billing_email": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "app_client_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.]*$"
          }
        }
      }
    },
    "emuLogin": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?_[A-Za-z0-9]+$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "parameterName": {
      "type": "string",
      "not": {
        "pattern": "[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_ -]?[Kk][Ee][Yy]|[Cc][Ll][Ii][Ee][Nn][Tt][_ -]?[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Aa][Pp][Ii][_ -]?[Kk][Ee][Yy]|^[Pp][Aa][Tt]$"
      }
    },
    "parameterValue": {
      "type": ["object", "array", "string", "number", "boolean", "null"],
      "propertyNames": { "$ref": "#/definitions/parameterName" },
      "if": { "type": "string" },
      "then": { "$ref": "#/definitions/parameterString" }
    },
    "parameterString": {
      "type": "string",
      "not": { "pattern": "-----BEGIN ([A-Z0-9]+ )?PRIVATE KEY-----|^(gh[pousr]_|github_pat_)" }
    },
    "confirmation": {
      "type": "boolean",
      "default": false
    },
    "githubId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "credentialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment"],
      "properties": {
        "environment": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "githubApp": { "$ref": "module.schema.json#/definitions/moduleName" }
      }
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]+$"
    },
    "team": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^@\\s]+@[^@\\s]+$"
      }
    }
  }
}
