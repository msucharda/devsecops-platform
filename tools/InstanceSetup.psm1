function Clear-SetupTokenVariable {
    [CmdletBinding()]
    param()

    foreach ($variable in $script:TokenVariables) {
        if ([Environment]::GetEnvironmentVariable($variable, 'Process')) {
            Remove-Item -LiteralPath "Env:$variable"
            Show-SetupMessage -Message "Cleared $variable in this PowerShell session. Bootstrap accepts only the stored gh sign-in."
        }
        if (-not $IsWindows) { continue }
        if ([Environment]::GetEnvironmentVariable($variable, 'User')) {
            if (Confirm-SetupAction -Prompt "$variable is set in your Windows user environment and overrides gh in every new shell. Remove it there?") {
                [Environment]::SetEnvironmentVariable($variable, $null, 'User')
            }
            else {
                Show-SetupMessage -Kind Warning -Message "$variable stays in your user environment. Remove it before bootstrap."
            }
        }
        if ([Environment]::GetEnvironmentVariable($variable, 'Machine')) {
            Show-SetupMessage -Kind Warning -Message "$variable is set for the whole machine. An administrator must remove it before bootstrap."
        }
    }
}

function Invoke-StepGitHubLogin {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $githubHost = $Setup.Settings['githubHost']
    Clear-SetupTokenVariable
    $Setup.GitHubToken = $null
    try {
        $null = Get-SetupGitHubToken -Setup $Setup
    }
    catch {
        $tokenError = $_
        $failure = Get-SetupFailure -ErrorRecord $tokenError
        if ($failure.Quit -or $failure.Status -ne 'Missing') { throw $tokenError }
        if (-not (Confirm-SetupAction -Prompt "gh is not signed in to $githubHost. Sign in now?" -DefaultYes)) { throw $tokenError }
        Invoke-SetupGitHubLogin -Setup $Setup
    }
    $userGuidance = @(
        'Sign in through Entra ID with your managed user. If GitHub rejects the account, finish A5 first:',
        'SCIM job active, direct Enterprise Owner assignment and provisioning of your user.'
    )
    $user = Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri "https://api.$githubHost/user") -Action 'Reading the gh user' -Guidance $userGuidance
    if ($user['login'] -like '*_admin') {
        Show-SetupMessage -Kind Warning -Message "gh is signed in as the setup user $($user['login']). Bootstrap needs your managed user, not the emergency account."
        if (-not (Confirm-SetupAction -Prompt 'Sign out the setup user and sign in with your managed user?' -DefaultYes)) {
            Exit-SetupStage -Status Error -Area github -Message "gh is signed in as the setup user $($user['login'])." -Guidance $userGuidance
        }
        & gh auth logout --hostname $githubHost --user $user['login'] | Out-Host
        Invoke-SetupGitHubLogin -Setup $Setup
        $user = Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri "https://api.$githubHost/user") -Action 'Reading the gh user' -Guidance $userGuidance
        if ($user['login'] -like '*_admin') {
            Exit-SetupStage -Status Error -Area github -Message "gh is still signed in as the setup user $($user['login'])." -Guidance $userGuidance
        }
    }
    Add-SetupGitHubScope -Setup $Setup -Scope 'read:enterprise' -Purpose 'the enterprise owner check of bootstrap' -Permanent
    $Setup.Facts.Login = [string] $user['login']
    return "gh is signed in to $githubHost as $($user['login']) with an OAuth token."
}

function Invoke-StepGitHubOwner {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $enterprise = $Setup.Settings['enterprise']
    $login = $Setup.Facts.Login
    $query = 'query($slug:String!,$login:String!){enterprise(slug:$slug){id viewerIsAdmin ownerInfo{admins(first:20,role:OWNER,query:$login){nodes{login}}}}}'
    $guidance = @(
        'SCIM maps the Enterprise Owner app role to the GitHub owner role. Check A5 and provision your user on demand,',
        'or wait for the next SCIM cycle (up to 40 minutes). Then choose [r].'
    )
    $data = Invoke-SetupGraphQL -Setup $Setup -Query $query -Variables @{ slug = $enterprise; login = $login } -Action 'Reading the enterprise owner role' -Guidance $guidance
    $enterpriseData = if ($data -is [System.Collections.IDictionary]) { $data['enterprise'] }
    if ($enterpriseData -isnot [System.Collections.IDictionary]) { Exit-SetupStage -Status Missing -Area github -Message "$login cannot see the enterprise $enterprise." -Guidance $guidance }
    $ownerInfo = $enterpriseData['ownerInfo']
    $owners = if ($ownerInfo -is [System.Collections.IDictionary] -and $ownerInfo['admins'] -is [System.Collections.IDictionary]) {
        @($ownerInfo['admins']['nodes'] | Where-Object { $_ -is [System.Collections.IDictionary] } | ForEach-Object { $_['login'] })
    }
    else { @() }
    if (-not $enterpriseData['viewerIsAdmin'] -or $login -notin $owners) {
        Exit-SetupStage -Status Forbidden -Area github -Message "$login is not an owner of the enterprise $enterprise." -Guidance $guidance
    }
    $Setup.Facts.EnterpriseId = [string] $enterpriseData['id']
    return "$login is an owner of the enterprise $enterprise."
}

function Get-SetupEnterprisePolicy {
    [CmdletBinding()]
    [OutputType([System.Collections.IDictionary])]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $query = "query(`$slug:String!){enterprise(slug:`$slug){ownerInfo{$(@($script:PolicySettings.Keys) -join ' ')}}}"
    $arguments = @{ Setup = $Setup; Query = $query; Variables = @{ slug = $Setup.Settings['enterprise'] }; Action = 'Reading the enterprise repository policies' }
    try {
        $data = Invoke-SetupGraphQL @arguments
    }
    catch {
        $failure = Get-SetupFailure -ErrorRecord $_
        if ($failure.Quit -or $failure.Status -ne 'Forbidden') { throw }
        Add-SetupGitHubScope -Setup $Setup -Scope 'admin:enterprise' -Purpose 'reading enterprise policies'
        $data = Invoke-SetupGraphQL @arguments
    }
    $ownerInfo = if ($data -is [System.Collections.IDictionary] -and $data['enterprise'] -is [System.Collections.IDictionary]) { $data['enterprise']['ownerInfo'] }
    if ($ownerInfo -isnot [System.Collections.IDictionary]) { Exit-SetupStage -Status Forbidden -Area github -Message 'GitHub did not return the enterprise policies.' }
    return $ownerInfo
}

function Invoke-StepEnterprisePolicy {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $policyGuidance = @(
        'Your enterprise > Policies > Member privileges: Repository forking = disabled for private and internal repositories,',
        'Repository creation, Repository visibility change and Repository deletion and transfer = members cannot. Then choose [r].'
    )
    Show-SetupMessage -Message 'AUTOMATIC: The wizard checks four repository policies through the API and changes them only after your confirmation.'
    # A retry must not keep a verification from an earlier attempt if this attempt fails.
    $Setup.Facts.RepositoryPoliciesDisabled = $false
    $policies = Get-SetupEnterprisePolicy -Setup $Setup
    $pending = @($script:PolicySettings.Keys | Where-Object { $policies[$_] -ne 'DISABLED' })
    if ($pending.Count -gt 0) {
        Show-SetupTable -Row @($pending | ForEach-Object { [pscustomobject]@{ Policy = $_; Current = $policies[$_]; Required = 'DISABLED' } })
        Show-SetupMessage -Message 'Members must not fork private or internal repositories, create repositories, change their visibility or delete them.'
        if (-not (Confirm-SetupAction -Prompt "Set $($pending.Count) enterprise policy(ies) to DISABLED now?" -DefaultYes)) {
            Exit-SetupStage -Status Missing -Message 'The enterprise repository policies are not enforced.' -Guidance $policyGuidance
        }
        Add-SetupGitHubScope -Setup $Setup -Scope 'admin:enterprise' -Purpose 'changing enterprise policies'
        $fields = for ($index = 0; $index -lt $pending.Count; $index++) {
            "p$index`: updateEnterprise$($script:PolicySettings[$pending[$index]])Setting(input:{enterpriseId:`$id,settingValue:DISABLED}){clientMutationId}"
        }
        $null = Invoke-SetupGraphQL -Setup $Setup -Query "mutation(`$id:ID!){$($fields -join ' ')}" -Variables @{ id = $Setup.Facts.EnterpriseId } `
            -Action 'Changing the enterprise repository policies' -Guidance $policyGuidance
        $policies = Get-SetupEnterprisePolicy -Setup $Setup
        $pending = @($script:PolicySettings.Keys | Where-Object { $policies[$_] -ne 'DISABLED' })
        if ($pending.Count -gt 0) {
            Exit-SetupStage -Status Error -Area github -Message "The policies did not change: $($pending -join ', ')." -Guidance $policyGuidance
        }
    }
    Show-SetupMessage -Kind Ok -Message 'AUTOMATIC: Verified DISABLED through the API: private/internal repository forking, member repository creation, member visibility changes and member repository deletion and transfer.'
    Show-SetupMessage -Message 'The next three settings are separate USER ACTIONS: user namespace restrictions, fine-grained PAT approval and PAT maximum lifetimes. Do not change other policies.'
    $Setup.Facts.RepositoryPoliciesDisabled = $true
    $unconfirmed = @(foreach ($name in $script:ConfirmedPolicies.Keys) {
        if (-not (Confirm-SetupPrerequisite -Setup $Setup -Name $name -Guidance $script:ConfirmedPolicies[$name] -Prompt "GitHub has no API for $name. Is it set?")) { $name }
    })
    if ($unconfirmed.Count -gt 0) {
        Exit-SetupStage -Status Missing -Message "Not confirmed: $($unconfirmed -join ', ')." -Guidance @('Set the policies in the UI, then choose [r].')
    }
    return 'Repository policies are DISABLED for members. PAT policies and user namespace restrictions are confirmed.'
}

function Invoke-StepGitHubLicense {
