      {
        "id": 2,
        "name": "Another Custom Pattern",
        "pattern": "prefix_[a-zA-Z0-9]{32}",
        "slug": "another-custom-pattern",
        "state": "unpublished",
        "push_protection_enabled": false,
        "start_delimiter": "\\b",
        "end_delimiter": "\\b",
        "must_match": [
          "^prefix_prod"
