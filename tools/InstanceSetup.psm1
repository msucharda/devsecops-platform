#region Stages A1-A2

function Invoke-StepTool {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $required = @(
        @{ Name = 'az'; Package = 'Microsoft.AzureCLI' }
        @{ Name = 'gh'; Package = 'GitHub.cli' }
    )
    $missing = @($required | Where-Object { -not (Test-SetupCommand -Name $_.Name) })
    if ($missing.Count -gt 0) {
        Exit-SetupStage -Status Missing -Message "Missing command-line tools: $(@($missing | ForEach-Object { $_.Name }) -join ', ')." -Guidance (@(
            $missing | ForEach-Object { "winget install --exact --id $($_.Package)" }
        ) + 'Open a new PowerShell window after the installation, then rerun the wizard.')
    }
    $installer = Join-Path $Setup.RepoPath 'tools/Install-ToolDependencies.ps1'
    if (-not (Test-SetupYamlModule)) {
        if (-not (Confirm-SetupAction -Prompt 'The PowerShell module powershell-yaml 0.4.12 is missing. Install it for the current user now?' -DefaultYes)) {
            Exit-SetupStage -Status Missing -Message 'powershell-yaml 0.4.12 is missing.' -Guidance @("Run: & '$installer'")
        }
        $null = & $installer
        if (-not (Test-SetupYamlModule)) {
            Exit-SetupStage -Status Error -Message 'powershell-yaml 0.4.12 is still missing after the installation.' -Guidance @("Run: & '$installer'")
        }
    }
    Import-Module -Name powershell-yaml -RequiredVersion 0.4.12
    Import-Module -Name (Join-Path $Setup.RepoPath 'tools/PlatformTools.psm1') -Force
    $null = New-Item -ItemType Directory -Force -Path (Join-Path $Setup.WorkPath 'keys')
    $Setup.Existing = $null
    if (Test-Path -LiteralPath $Setup.InstancePath) {
        $guidance = @('Fix or delete the file, then choose [r].')
        try {
            $existing = ConvertFrom-Yaml -Yaml (Get-Content -LiteralPath $Setup.InstancePath -Raw) -Ordered
        }
        catch {
            Exit-SetupStage -Status Error -Message "Cannot read $($Setup.InstancePath): $($_.Exception.Message)" -Guidance $guidance
        }
        if ($existing -isnot [System.Collections.IDictionary]) {
            Exit-SetupStage -Status Error -Message "$($Setup.InstancePath) does not contain a YAML mapping." -Guidance $guidance
        }
        $Setup.Existing = $existing
    }
    $source = if ($Setup.Existing) { "existing $($Setup.InstancePath)" } else { 'no instance.yaml yet' }
    return "az, gh and powershell-yaml are available. Work folder $($Setup.WorkPath), $source."
}

function Test-SetupGuid {
    [CmdletBinding()]
    [OutputType([bool])]
    param([AllowEmptyString()][string] $Value)

    return $Value -match '^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$'
}

function Get-SetupInputProblem {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)][string] $Name,
        [AllowEmptyString()][string] $Value
    )

    switch ($Name) {
        'name' { if ($Value -cnotmatch '^[a-z][a-z0-9]{1,7}$') { 'Use 2 to 8 lowercase letters and digits, starting with a letter.' } }
        'region' { if ($Value -cnotmatch '^[a-z][a-z0-9]+$') { 'Use an Azure region name such as westeurope.' } }
        'enterprise' {
            if ($Value.Length -gt 63 -or $Value -cnotmatch '^[a-z][a-z0-9]*(-[a-z0-9]+)*$') { 'Use the enterprise slug from https://<slug>.ghe.com.' }
        }
        default { if (-not (Test-SetupGuid -Value $Value)) { 'Use a GUID such as 00000000-0000-0000-0000-000000000000.' } }
    }
}

function Get-SetupInputDefault {
    [CmdletBinding()]
    [OutputType([hashtable])]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $defaults = @{}
    $sessionPath = Join-Path $Setup.WorkPath 'session.ps1'
    if (Test-Path -LiteralPath $sessionPath) {
        $names = @{
            name = 'name'; region = 'region'; tenantId = 'tenantId'; mgmtSub = 'managementSubscriptionId'
            enterprise = 'enterprise'; spId = 'enterpriseApplicationObjectId'
        }
        foreach ($line in Get-Content -LiteralPath $sessionPath) {
            if ($line -match '^\s*\$(\w+)\s*=\s*''([^'']+)''\s*$' -and $names.ContainsKey($Matches[1])) {
                $defaults[$names[$Matches[1]]] = $Matches[2]
            }
            elseif ($line -match '^\s*\$subscriptionIds\s*=\s*@\((.*)\)\s*$') {
                $defaults['subscriptionIds'] = @([regex]::Matches($Matches[1], '''([^'']+)''') | ForEach-Object { $_.Groups[1].Value })
            }
        }
    }
    $existing = $Setup.Existing
    if ($existing -is [System.Collections.IDictionary]) {
        if ($existing['instance'] -is [System.Collections.IDictionary] -and $existing['instance']['name']) {
            $defaults['name'] = [string] $existing['instance']['name']
        }
        if ($existing['regions'] -is [System.Collections.IDictionary] -and $existing['regions']['primary']) {
            $defaults['region'] = [string] $existing['regions']['primary']
        }
        if ($existing['bootstrap'] -is [System.Collections.IDictionary]) {
            foreach ($key in @('tenantId', 'managementSubscriptionId', 'enterprise', 'enterpriseApplicationObjectId')) {
                if ($existing['bootstrap'][$key]) { $defaults[$key] = [string] $existing['bootstrap'][$key] }
            }
            if ($existing['bootstrap']['subscriptionIds'] -is [System.Collections.IList]) {
                $defaults['subscriptionIds'] = @($existing['bootstrap']['subscriptionIds'] | ForEach-Object { [string] $_ })
            }
        }
    }
    foreach ($key in @($Setup.Settings.Keys)) {
        if ($Setup.Settings[$key]) { $defaults[$key] = $Setup.Settings[$key] }
    }
    return $defaults
}

function Invoke-StepInput {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $defaults = Get-SetupInputDefault -Setup $Setup
    $fields = [ordered]@{
        name = 'Instance name (2-8 lowercase letters and digits)'
        region = 'Azure region'
        tenantId = 'Entra tenant ID'
        managementSubscriptionId = 'Management subscription ID'
        enterprise = 'GitHub enterprise slug (<slug>.ghe.com)'
    }
    $values = @{}
    $complete = @($fields.Keys | Where-Object { Get-SetupInputProblem -Name $_ -Value ([string] $defaults[$_]) }).Count -eq 0
    if ($complete) {
        $extra = @($defaults['subscriptionIds'] | Where-Object { $_ -and $_ -ne $defaults['managementSubscriptionId'] })
        Show-SetupTable -Row @(
            foreach ($field in $fields.Keys) { [pscustomobject]@{ Input = $fields[$field]; Value = $defaults[$field] } }
            [pscustomobject]@{ Input = 'Additional subscriptions'; Value = $(if ($extra.Count) { $extra -join ', ' } else { '-' }) }
        )
        if (Confirm-SetupAction -Prompt 'Use these values?' -DefaultYes) {
            foreach ($field in $fields.Keys) { $values[$field] = [string] $defaults[$field] }
            $values['extra'] = $extra
        }
    }
    if ($values.Count -eq 0) {
        foreach ($field in $fields.Keys) {
            $values[$field] = Read-SetupValue -Prompt $fields[$field] -Default ([string] $defaults[$field]) -Validate {
                param($text)
                Get-SetupInputProblem -Name $field -Value $text
            }
        }
        $extraDefault = @($defaults['subscriptionIds'] | Where-Object { $_ -and $_ -ne $values['managementSubscriptionId'] }) -join ','
        $extraText = Read-SetupValue -Prompt 'Additional subscription IDs for modules (comma-separated, - for none)' `
            -Default $(if ($extraDefault) { $extraDefault } else { '-' }) -Validate {
            param($text)
            if ($text -ne '-') {
                foreach ($part in $text -split ',') { if (-not (Test-SetupGuid -Value $part.Trim())) { "'$($part.Trim())' is not a GUID." } }
            }
        }
        $values['extra'] = if ($extraText -eq '-') { @() } else { @($extraText -split ',' | ForEach-Object { $_.Trim() }) }
    }
    $enterprise = $values['enterprise']
    if (-not (Resolve-SetupHostName -Name "api.$enterprise.ghe.com")) {
        Show-SetupMessage -Kind Warning -Message "api.$enterprise.ghe.com does not resolve. Check the enterprise slug and the network."
        $enterprise = Read-SetupValue -Prompt $fields['enterprise'] -Default $enterprise -Validate {
            param($text)
            $problem = Get-SetupInputProblem -Name 'enterprise' -Value $text
            if ($problem) { $problem }
            elseif (-not (Resolve-SetupHostName -Name "api.$text.ghe.com")) { "api.$text.ghe.com does not resolve." }
        }
    }
    $management = $values['managementSubscriptionId'].ToLowerInvariant()
    $Setup.Settings['name'] = $values['name']
    $Setup.Settings['region'] = $values['region']
    $Setup.Settings['tenantId'] = $values['tenantId'].ToLowerInvariant()
    $Setup.Settings['managementSubscriptionId'] = $management
    $Setup.Settings['subscriptionIds'] = [string[]] @(@($management) + @($values['extra'] | ForEach-Object { $_.ToLowerInvariant() }) | Select-Object -Unique)
    $Setup.Settings['enterprise'] = $enterprise
    $Setup.Settings['githubHost'] = "$enterprise.ghe.com"
    if (-not $Setup.Settings['enterpriseApplicationObjectId'] -and (Test-SetupGuid -Value ([string] $defaults['enterpriseApplicationObjectId']))) {
        $Setup.Settings['enterpriseApplicationObjectId'] = ([string] $defaults['enterpriseApplicationObjectId']).ToLowerInvariant()
    }
    $Setup.AzureTokens.Clear()
    $Setup.GitHubToken = $null
    return "Instance $($values['name']) in $($values['region']), $(@($Setup.Settings['subscriptionIds']).Count) subscription(s), enterprise $enterprise.ghe.com."
}

function Invoke-StepAzureLogin {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $tenantId = $Setup.Settings['tenantId']
    try {
        $null = Get-SetupAzureToken -Setup $Setup -TokenHost 'graph.microsoft.com'
    }
    catch {
        $tokenError = $_
        $failure = Get-SetupFailure -ErrorRecord $tokenError
        if ($failure.Quit -or $failure.Status -ne 'Missing') { throw $tokenError }
        if (-not (Confirm-SetupAction -Prompt "Azure CLI is not signed in to tenant $tenantId. Sign in now?" -DefaultYes)) { throw $tokenError }
        Invoke-SetupAzureLogin -Setup $Setup
        $null = Get-SetupAzureToken -Setup $Setup -TokenHost 'graph.microsoft.com'
    }
    $null = Get-SetupAzureToken -Setup $Setup -TokenHost 'management.azure.com'
    $user = Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri "$script:Graph/me?`$select=id,userPrincipalName,userType") `
        -Action 'Reading the signed-in user'
    if ($user['userType'] -ne 'Member') {
        Exit-SetupStage -Status Error -Area azure -Message "$($user['userPrincipalName']) is a $($user['userType']) account. Bootstrap needs a member account of the tenant." `
            -Guidance @('Choose [l] and sign in with a member account.')
    }
    $Setup.Facts.Me = $user['id']
    $Setup.Facts.Upn = $user['userPrincipalName']
    $roles = @(Get-SetupCollection -Setup $Setup -Uri "$script:Graph/me/memberOf/microsoft.graph.directoryRole" -Action 'Reading your active directory roles')
    $roleNames = @($roles | ForEach-Object { $_['displayName'] } | Sort-Object)
    Show-SetupMessage -Message "Active directory roles: $(if ($roleNames.Count) { $roleNames -join ', ' } else { 'none' }). Eligible PIM roles count only after activation."
    return "Azure CLI is signed in as $($user['userPrincipalName'])."
}

function Invoke-StepEntraLicense {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $skus = @(Get-SetupCollection -Setup $Setup -Uri "$script:Graph/subscribedSkus" -Action 'Reading tenant licenses')
    $licensed = @($skus | Where-Object {
        $_['capabilityStatus'] -eq 'Enabled' -and $_['prepaidUnits']['enabled'] -gt 0 -and
        @($_['servicePlans'] | Where-Object {
            $_['servicePlanName'] -in @('AAD_PREMIUM', 'AAD_PREMIUM_P2') -and $_['provisioningStatus'] -eq 'Success'
        }).Count -gt 0
    })
    if ($licensed.Count -eq 0) {
        Exit-SetupStage -Status Missing -Message 'No enabled license provides Entra ID P1 or P2.' -Guidance @(
            'The EMU OIDC setup and bootstrap need Entra ID P1 or P2 (for example Microsoft 365 E3/E5 or EMS).',
            'Microsoft 365 admin center > Billing > Purchase services: buy or start a trial, then choose [r].'
        )
    }
    return "Entra ID P1 or P2 is provided by $(@($licensed | ForEach-Object { $_['skuPartNumber'] }) -join ', ')."
}

