{
  "source": {
    "operation": "GET /repos/{owner}/{repo}/rulesets/{ruleset_id}",
    "operationId": "repos/get-repo-ruleset",
    "documentation": "https://docs.github.com/en/enterprise-cloud@latest/rest/repos/rules#get-a-repository-ruleset",
    "apiVersion": "2026-03-10",
    "description": "https://github.com/github/rest-api-description/blob/bb754941722779d8a5b3a2f25a5fbb7ce794e1ea/descriptions/ghec/ghec.2026-03-10.json",
    "status": 200,
    "schema": "#/components/schemas/repository-ruleset",
    "note": "The documented repository-ruleset schema with sanitized enterprise ownership and explicit update/deletion restrictions for the control ref."
  },
  "required": {
    "": ["id", "name", "source", "enforcement"],
    "rules.[]": ["type"]
  },
  "body": {
    "id": 42,
    "name": "platform-development-control",
    "target": "branch",
    "source_type": "Enterprise",
    "source": "example",
    "enforcement": "active",
    "bypass_actors": [
      { "actor_type": "EnterpriseOwner", "bypass_mode": "always" }
    ],
    "conditions": {
      "ref_name": {
        "include": ["refs/heads/platform-control"],
        "exclude": []
      }
    },
    "rules": [
      { "type": "update", "parameters": { "update_allows_fetch_and_merge": false } },
      { "type": "deletion" }
    ]
  }
}
