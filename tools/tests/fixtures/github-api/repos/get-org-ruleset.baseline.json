{
  "source": {
    "operation": "GET /orgs/{org}/rulesets/{ruleset_id}",
    "operationId": "repos/get-org-ruleset",
    "documentation": "https://docs.github.com/en/enterprise-cloud@latest/rest/orgs/rules#get-an-organization-repository-ruleset",
    "apiVersion": "2026-03-10",
    "description": "https://github.com/github/rest-api-description/blob/bb754941722779d8a5b3a2f25a5fbb7ce794e1ea/descriptions/ghec/ghec.2026-03-10.json",
    "status": 200,
    "schema": "#/components/schemas/repository-ruleset",
    "variant": "repository_name_and_ref_name; code_scanning, deletion, non_fast_forward, pull_request",
    "note": "Synthetic baseline example using the pinned response schema and its four rule variants, independent of Terraform and stub writes. The pull_request field require_extra_approval_for_unattributed_changes is an observed, approved extension, not part of the pinned OpenAPI; primary observation is recorded in repos/get-org-ruleset and issue #122."
  },
  "required": {
    "": ["id", "name", "source", "enforcement"],
    "rules.[]": ["type"]
  },
  "body": {
    "id": 21,
    "name": "platform-default-branch",
    "target": "branch",
    "source_type": "Organization",
    "source": "demo",
    "enforcement": "active",
    "bypass_actors": [],
    "conditions": {
      "ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []},
      "repository_name": {"include": ["~ALL"], "exclude": [], "protected": false}
    },
    "rules": [
      {
        "type": "code_scanning",
        "parameters": {
          "code_scanning_tools": [
            {"tool": "CodeQL", "alerts_threshold": "none", "security_alerts_threshold": "high_or_higher"}
          ]
        }
      },
      {"type": "deletion"},
      {"type": "non_fast_forward"},
      {
        "type": "pull_request",
        "parameters": {
          "allowed_merge_methods": ["merge", "rebase", "squash"],
          "dismiss_stale_reviews_on_push": true,
          "require_code_owner_review": true,
          "require_extra_approval_for_unattributed_changes": true,
          "require_last_push_approval": false,
          "required_approving_review_count": 1,
          "required_review_thread_resolution": false
        }
      }
    ]
  }
}
