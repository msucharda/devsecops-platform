function Test-SetupStageOk {
    [CmdletBinding()]
    [OutputType([bool])]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string[]] $Id
    )

    foreach ($stageId in $Id) {
        if (-not $Setup.Stages.Contains($stageId) -or $Setup.Stages[$stageId].Status -ne 'Ok') { return $false }
    }
    return $true
}

function Get-SetupFlag {
    [CmdletBinding()]
    [OutputType([System.Collections.Specialized.OrderedDictionary])]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $confirmations = $Setup.State.confirmations
    $policiesRan = $Setup.Stages.Contains('enterprise-policies') -and $Setup.Stages['enterprise-policies'].Status -ne 'Skipped'
    $flags = [ordered]@{}
    foreach ($flagName in $script:FlagOrder) {
        $flags[$flagName] = switch ($flagName) {
            'tenant' { Test-SetupStageOk -Setup $Setup -Id 'azure-login', 'entra-license' }
            'subscriptions' { Test-SetupStageOk -Setup $Setup -Id 'subscriptions', 'azure-owner', 'resource-providers', 'management-groups' }
            'enterpriseOidc' { (Test-SetupStageOk -Setup $Setup -Id 'enterprise-app') -and ([bool] $Setup.Facts.OidcModeVerified -or (Test-SetupStageOk -Setup $Setup -Id 'github-owner')) }
            'enterpriseScim' { Test-SetupStageOk -Setup $Setup -Id 'scim' }
            'enterpriseOwner' { Test-SetupStageOk -Setup $Setup -Id 'owner-assignment', 'github-owner' }
            'licenses' { (Test-SetupStageOk -Setup $Setup -Id 'entra-license', 'github-licenses') -and $confirmations.Contains('licenses') }
            'privateInternalForksDisabled' { [bool] $Setup.Facts.RepositoryPoliciesDisabled }
            'repositoryManagementPoliciesEnforced' { [bool] $Setup.Facts.RepositoryPoliciesDisabled }
            'githubAppAvailabilityVerified' { Test-SetupStageOk -Setup $Setup -Id 'probe-authorization', 'probe-admin' }
            # The wizard runs before live workflows exist; keep the platform team's later confirmation.
            'liveWorkflowsPromoted' {
                $existing = $Setup.Existing
                $existing -is [System.Collections.IDictionary] -and
                    $existing['manualPrerequisites'] -is [System.Collections.IDictionary] -and
                    $existing['manualPrerequisites'][$flagName] -is [bool] -and
                    $existing['manualPrerequisites'][$flagName]
            }
            default { $policiesRan -and $confirmations.Contains($flagName) }
        }
    }
    return $flags
}

function Copy-SetupData {
    [CmdletBinding()]
    param([AllowNull()] $Value)

    if ($null -eq $Value) { return $null }
    return , (ConvertFrom-Json -InputObject (ConvertTo-Json -InputObject $Value -Depth 100) -AsHashtable -NoEnumerate)
}

function Get-SetupConfiguration {
    [CmdletBinding()]
    [OutputType([System.Collections.Specialized.OrderedDictionary])]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][System.Collections.IDictionary] $Modules
    )

    $base = if ($Setup.Existing -is [System.Collections.IDictionary]) { Copy-SetupData -Value $Setup.Existing } else { @{} }
    $settings = $Setup.Settings
    $upn = [string] $Setup.Facts.Upn
    $section = {
        param([string] $SectionName)
        if ($base.Contains($SectionName) -and $base[$SectionName] -is [System.Collections.IDictionary]) { $base[$SectionName] } else { [ordered]@{} }
    }
    $instanceSection = & $section 'instance'
    $instanceSection['name'] = $settings['name']
    $regionSection = & $section 'regions'
    $regionSection['primary'] = $settings['region']
    $teamSection = & $section 'teams'
    $members = @{}
    foreach ($team in @('platform', 'security')) {
        $members[$team] = @(@($teamSection[$team]) | Where-Object { $_ -is [string] -and $_ -and $_ -notmatch '@example\.test$' })
    }
    if ($upn -and $upn -notin $members['platform']) { $members['platform'] = @($members['platform']) + $upn }
    if ($members['security'].Count -eq 0 -and $upn) { $members['security'] = @($upn) }
    $teamSection['platform'] = [string[]] $members['platform']
    $teamSection['security'] = [string[]] $members['security']
    $moduleSection = & $section 'modules'
    if ($moduleSection.Count -eq 0 -and $Modules.Contains('application')) { $moduleSection['application'] = [ordered]@{} }
    $config = [ordered]@{}
    foreach ($key in $script:ConfigOrder) {
        $config[$key] = switch ($key) {
            'instance' { $instanceSection }
            'regions' { $regionSection }
            'teams' { $teamSection }
            'modules' { $moduleSection }
            'customPatterns' { if ($base.Contains('customPatterns') -and $base['customPatterns'] -is [System.Collections.IList]) { , $base['customPatterns'] } else { , @() } }
            'bootstrap' {
                [ordered]@{
                    tenantId = $settings['tenantId']
                    managementSubscriptionId = $settings['managementSubscriptionId']
                    subscriptionIds = [string[]] @($settings['subscriptionIds'])
                    enterpriseApplicationObjectId = $settings['enterpriseApplicationObjectId']
                    githubHost = $settings['githubHost']
                    enterprise = $settings['enterprise']
                }
            }
            'manualPrerequisites' { Get-SetupFlag -Setup $Setup }
            'teardown' { if ($base.Contains('teardown') -and $base['teardown'] -is [System.Collections.IDictionary]) { $base['teardown'] } else { [ordered]@{ allowed = $false } } }
            default { & $section $key }
        }
    }
    foreach ($key in @($base.Keys | Where-Object { $_ -notin $script:ConfigOrder })) { $config[$key] = $base[$key] }
    return $config
}

function ConvertTo-SetupFlatMap {
    [CmdletBinding()]
    [OutputType([hashtable])]
    param(
        [AllowNull()] $Value,
        [string] $Path = '$',
        [hashtable] $Map = @{}
    )

    if ($Value -is [System.Collections.IDictionary] -and $Value.Count -gt 0) {
        foreach ($key in $Value.Keys) { $null = ConvertTo-SetupFlatMap -Value $Value[$key] -Path "$Path.$key" -Map $Map }
    }
    elseif ($Value -is [System.Collections.IList]) {
        $Map[$Path] = ConvertTo-Json -InputObject @($Value) -Compress -Depth 100
    }
    elseif ($Value -is [System.Collections.IDictionary]) {
        $Map[$Path] = '{}'
    }
    else {
        $Map[$Path] = ConvertTo-Json -InputObject $Value -Compress
    }
    return $Map
}

function Format-SetupSessionScript {
    [CmdletBinding()]
    [OutputType([string])]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $quote = { param($Text) "'$(([string] $Text).Replace("'", "''"))'" }
    $settings = $Setup.Settings
    $values = [ordered]@{
        name = $settings['name']; region = $settings['region']; tenantId = $settings['tenantId']; mgmtSub = $settings['managementSubscriptionId']
        enterprise = $settings['enterprise']; githubHost = $settings['githubHost']; api = "https://api.$($settings['githubHost'])"
        upn = $Setup.Facts.Upn; spId = $settings['enterpriseApplicationObjectId']; userRole = $Setup.Facts.UserRoleId; login = $Setup.Facts.Login
        probeOrg = $Setup.State.probe['organization']; repo = $Setup.RepoPath; work = $Setup.WorkPath; cfg = $Setup.InstancePath
        modulesPath = $Setup.ModulesPath
    }
    $lines = [System.Collections.Generic.List[string]]::new()
    $lines.Add($script:SessionMarker)
    $lines.Add('# Instance data for the runbook commands. Never commit this file to the source repository (ADR 0012).')
    foreach ($variable in $values.Keys) {
        if ($values[$variable]) { $lines.Add("`$$variable = $(& $quote $values[$variable])") }
    }
    $lines.Add("`$subscriptionIds = @($(@($settings['subscriptionIds'] | ForEach-Object { & $quote $_ }) -join ', '))")
    $probe = $Setup.State.probe
    if ($probe['adminAppId'] -and $probe['adminInstallationId']) {
        $keyPath = Join-Path $Setup.WorkPath 'keys/probe-admin.pem'
        $lines.Add("`$adminApp = @{ AppId = $(& $quote $probe['adminAppId']); InstallationId = $(& $quote $probe['adminInstallationId']); KeyPath = $(& $quote $keyPath) }")
    }
    return ($lines -join "`n") + "`n"
}

function Invoke-StepConfiguration {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    $modules = Get-PlatformModuleGraph -ModulesPath $Setup.ModulesPath
    $config = Get-SetupConfiguration -Setup $Setup -Modules $modules
    $yaml = "# Generated by tools/Start-InstanceSetup.ps1 from verified results. Instance data; never commit it to the source repository.`n" +
        ((ConvertTo-Yaml -Data $config) -replace '\r?\n', "`n")
    $temporary = Join-Path $Setup.WorkPath "instance.yaml.$([guid]::NewGuid().ToString('N')).tmp"
    try {
        [System.IO.File]::WriteAllText($temporary, $yaml, [System.Text.UTF8Encoding]::new($false))
        try {
            $null = Get-PlatformInstance -Path $temporary -Modules $modules
            $parsed = Get-PlatformYaml -Path $temporary
        }
        catch {
            Exit-SetupStage -Status Error -Message "The generated configuration is invalid: $($_.Exception.Message)" -Guidance @('Fix or delete the existing instance.yaml, then choose [r].')
        }
        if ((ConvertTo-PlatformCanonicalJson -Value $parsed) -cne (ConvertTo-PlatformCanonicalJson -Value $config)) {
            Exit-SetupStage -Status Error -Message 'The YAML serialization changed a value of the configuration.'
        }
    }
    finally {
        Remove-Item -LiteralPath $temporary -Force -ErrorAction SilentlyContinue
    }
    $before = if ($Setup.Existing) { ConvertTo-SetupFlatMap -Value $Setup.Existing } else { @{} }
    $after = ConvertTo-SetupFlatMap -Value $config
    $changes = @(@($before.Keys) + @($after.Keys) | Sort-Object -Unique | Where-Object { $before[$_] -cne $after[$_] } | ForEach-Object {
        [pscustomobject]@{ Path = $_; Current = $(if ($before.Contains($_)) { $before[$_] } else { '-' }); New = $(if ($after.Contains($_)) { $after[$_] } else { '-' }) }
    })
    $sessionPath = Join-Path $Setup.WorkPath 'session.ps1'
    $session = Format-SetupSessionScript -Setup $Setup
    $sessionCurrent = if (Test-Path -LiteralPath $sessionPath) { Get-Content -LiteralPath $sessionPath -Raw } else { '' }
    $sessionChanged = $sessionCurrent -cne $session
    $flags = $config['manualPrerequisites']
    $unverified = @($flags.Keys | Where-Object { -not $flags[$_] })
    if ($changes.Count -eq 0 -and -not $sessionChanged) { return "instance.yaml is up to date. Unverified flags: $(if ($unverified.Count) { $unverified -join ', ' } else { 'none' })." }
    if ($changes.Count -gt 0) {
        Show-SetupMessage -Message "Changes in $($Setup.InstancePath):"
        Show-SetupTable -Row $changes
    }
    if ($sessionChanged) {
        $backup = if ($sessionCurrent -and -not $sessionCurrent.StartsWith($script:SessionMarker)) { ' Your current file is kept as session.ps1.bak.' } else { '' }
        Show-SetupMessage -Message "The wizard also updates $sessionPath with the variables for the runbook commands.$backup"
    }
    if ($unverified.Count -gt 0) { Show-SetupMessage -Kind Warning -Message "These flags stay false because their steps did not pass: $($unverified -join ', ')." }
    if (-not (Confirm-SetupAction -Prompt 'Write the files?' -DefaultYes)) {
        Exit-SetupStage -Status Missing -Message 'instance.yaml was not written.' -Guidance @('Choose [r] to show the changes again.')
    }
    if ($changes.Count -gt 0) {
        if (Test-Path -LiteralPath $Setup.InstancePath) { Copy-Item -LiteralPath $Setup.InstancePath -Destination "$($Setup.InstancePath).bak" -Force }
        [System.IO.File]::WriteAllText($Setup.InstancePath, $yaml, [System.Text.UTF8Encoding]::new($false))
        $Setup.Existing = ConvertFrom-Yaml -Yaml $yaml -Ordered
    }
    if ($sessionChanged) {
        if ($backup) { Copy-Item -LiteralPath $sessionPath -Destination "$sessionPath.bak" -Force }
        [System.IO.File]::WriteAllText($sessionPath, $session, [System.Text.UTF8Encoding]::new($false))
    }
    $flagText = if ($unverified.Count) { "Unverified flags: $($unverified -join ', ')." } else { 'All manual prerequisite flags are verified.' }
    return "Wrote $($Setup.InstancePath). $flagText"
}

function Invoke-StepPreflight {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    try {
        $rows = @(& (Join-Path $Setup.RepoPath 'tools/Test-BootstrapPrerequisites.ps1') -InstancePath $Setup.InstancePath -ModulesPath $Setup.ModulesPath)
    }
    catch {
        Exit-SetupStage -Status Error -Message "Preflight stopped: $($_.Exception.Message)" -Guidance @('Fix the reported problem, then choose [r].')
    }
    Show-SetupTable -Row @($rows | Select-Object -Property Area, Check, Status, Detail)
    $failed = @($rows | Where-Object { $_.Status -in @('Fail', 'Skip') })
    $manual = @($rows | Where-Object { $_.Area -eq 'Manual prerequisites' -and $_.Status -ne 'Confirmed' })
    if ($failed.Count -gt 0) {
        Exit-SetupStage -Status Error -Message "$($failed.Count) preflight check(s) failed or were skipped." -Guidance @(
            'Fix the checks with Status Fail; checks with Status Skip depend on them. Then choose [r].'
        )
    }
    if ($manual.Count -gt 0) {
        Exit-SetupStage -Status Missing -Message "$($manual.Count) manual prerequisite flag(s) are false." -Guidance @(
            'Finish the failed or skipped wizard steps and run the wizard again. It sets a flag only after its step passes.'
        )
    }
    return "Preflight passed all $($rows.Count) checks. Continue with phase B: bootstrap."
}

