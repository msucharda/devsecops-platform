{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "prerequisites", "manualSteps", "permissions"],
  "properties": {
    "name": { "$ref": "#/definitions/moduleName" },
    "description": { "$ref": "#/definitions/nonBlankString" },
    "organizationScoped": {
      "description": "Run each root once per instance organization, with an isolated state and installation token.",
      "const": true
    },
    "organizationParameters": {
      "description": "Parameters supplied as organization-keyed mappings; each root receives only its organization's value.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/phaseReference" }
    },
    "phases": {
      "description": "Additional Terraform roots in the same module. Each phase has its own dependencies and state but shares the module's plan/apply credentials.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/definitions/moduleName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prerequisites"],
        "properties": {
          "prerequisites": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/phaseReference" }
          },
          "manualPrerequisites": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
          }
        }
      }
    },
    "manualPrerequisites": {
      "description": "Instance manual prerequisite names the module plan and apply require. The runner reports them as declarations only.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
    },
    "manualSteps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "$ref": "#/definitions/moduleName" },
          "description": { "$ref": "#/definitions/nonBlankString" },
          "owner": { "enum": ["platform", "security"], "default": "platform" },
          "limitations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["plan", "drift", "teardown"],
            "properties": {
              "plan": { "$ref": "#/definitions/nonBlankString" },
              "drift": { "$ref": "#/definitions/nonBlankString" },
              "teardown": { "$ref": "#/definitions/nonBlankString" }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["azure", "microsoftGraph", "githubApp", "adminPat"],
      "properties": {
        "azure": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "scope"],
            "properties": {
              "role": { "$ref": "#/definitions/nonBlankString" },
              "scope": { "$ref": "#/definitions/nonBlankString" },
              "phase": { "enum": ["plan", "apply"], "default": "apply" }
            }
          }
        },
        "microsoftGraph": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/graphPermission" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["permission", "phase"],
                "properties": {
                  "permission": { "$ref": "#/definitions/graphPermission" },
                  "phase": { "enum": ["plan", "apply"] }
                }
              }
            ]
          }
        },
        "githubApp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan": { "$ref": "#/definitions/githubAppPhase" },
            "apply": { "$ref": "#/definitions/githubAppPhase" },
            "rulesetPlan": { "$ref": "#/definitions/githubAppPhase" }
          },
          "if": { "minProperties": 1 },
          "then": { "required": ["plan", "apply"] }
        },
        "adminPat": {
          "type": "array",
          "maxItems": 0
        },
        "entraDirectoryRoles": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase", "scope", "actions"],
            "properties": {
              "phase": { "enum": ["plan", "apply"] },
              "scope": { "const": "enterpriseApplication" },
              "actions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^microsoft\\.directory/servicePrincipals/[A-Za-z][A-Za-z0-9.]*(/[A-Za-z][A-Za-z0-9.]*)*$"
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["organizationParameters"] },
      "then": { "required": ["organizationScoped"] }
    },
    {
      "if": { "required": ["organizationScoped"] },
      "then": {
        "properties": {
          "permissions": {
            "properties": {
              "githubApp": {
                "required": ["plan", "apply"],
                "additionalProperties": {
                  "properties": {
                    "resources": {
                      "required": ["organizations"],
                      "properties": { "organizations": { "const": "target_organizations" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "githubAppPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissions", "resources"],
      "properties": {
        "permissions": { "$ref": "#/definitions/githubAppPermissions" },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            { "required": ["organizations"], "not": { "required": ["enterprise"] } },
            { "required": ["enterprise"], "not": { "anyOf": [{ "required": ["organizations"] }, { "required": ["repositories"] }] } }
          ],
          "properties": {
            "enterprise": { "const": true },
            "organizations": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "repositories": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "installationSelection": { "enum": ["none", "all"] }
          },
          "allOf": [
            {
              "if": { "required": ["installationSelection"] },
              "then": { "required": ["organizations"], "not": { "required": ["repositories"] } }
            }
          ]
        },
        "purpose": { "const": "organization-rulesets-full-read" }
      }
    },
    "githubAppPermissions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "enum": ["read", "write"] }
    },
    "githubAppResources": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["organizations"], "not": { "required": ["enterprise"] } },
        { "required": ["enterprise"], "not": { "anyOf": [{ "required": ["organizations"] }, { "required": ["repositories"] }] } }
      ],
      "properties": {
        "enterprise": { "const": true },
        "organizations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/githubOrganization" }
        },
        "repositories": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/githubOrganization" },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
          }
        }
      }
    },
    "githubOrganization": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "graphPermission": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
    },
    "moduleName": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "phaseReference": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(:[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
    },
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
