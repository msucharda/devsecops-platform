#region API

function Invoke-SetupApi {
    [CmdletBinding()]
    [OutputType([hashtable])]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string] $Uri,
        [ValidateSet('GET', 'POST', 'PUT', 'PATCH', 'DELETE')][string] $Method = 'GET',
        $Body,
        [string] $Token,
        [switch] $NoRetry
    )

    $address = $null
    if (-not [uri]::TryCreate($Uri, [System.UriKind]::Absolute, [ref] $address)) { throw "Untrusted setup API address '$Uri'." }
    $githubApi = "api.$($Setup.Settings['githubHost'])"
    $area = if ($address.Host -in @('graph.microsoft.com', 'management.azure.com')) { 'azure' }
    elseif ($Setup.Settings['githubHost'] -and $address.Host -eq $githubApi) { 'github' }
    else { '' }
    if ($address.Scheme -ne 'https' -or -not $address.IsDefaultPort -or $address.UserInfo -or $address.Fragment -or -not $area) {
        throw "Untrusted setup API address '$Uri'."
    }
    if (-not $Token) {
        $Token = if ($area -eq 'github') { Get-SetupGitHubToken -Setup $Setup } else { Get-SetupAzureToken -Setup $Setup -TokenHost $address.Host }
    }
    $accept = if ($area -eq 'github') { 'application/vnd.github+json' } else { 'application/json' }
    $arguments = @{
        Uri = $Uri
        Method = $Method
        Headers = @{ Authorization = "Bearer $Token"; Accept = $accept }
        SkipHttpErrorCheck = $true
        MaximumRedirection = 0
        TimeoutSec = 60
    }
    if ($null -ne $Body) {
        $arguments.Body = ConvertTo-Json -InputObject $Body -Depth 100 -Compress
        $arguments.ContentType = 'application/json'
    }
    $response = $null
    $attemptLimit = if ($NoRetry) { 1 } else { 6 }
    for ($attempt = 1; $attempt -le $attemptLimit; $attempt++) {
        try {
            $response = Invoke-WebRequest @arguments
        }
        catch {
            if ($attempt -eq $attemptLimit) {
                Exit-SetupStage -Status Error -Area $area -Message "$Method $($address.GetLeftPart('Path')) failed: $($_.Exception.Message)" `
                    -Guidance @('Check the network connection, then choose [r].')
            }
            Write-Verbose -Message "Retrying $Method $($address.GetLeftPart('Path')) after: $($_.Exception.Message)"
            Start-Sleep -Seconds 5
            continue
        }
        if ([int] $response.StatusCode -in @(429, 500, 502, 503, 504) -and $attempt -lt $attemptLimit) {
            Write-Verbose -Message "Retrying $Method $($address.GetLeftPart('Path')) after HTTP $($response.StatusCode)."
            Start-Sleep -Seconds 5
            continue
        }
        break
    }
    $content = if ($response.Content -is [byte[]]) { [System.Text.Encoding]::UTF8.GetString($response.Content) } else { [string] $response.Content }
    $data = $null
    if (-not [string]::IsNullOrWhiteSpace($content)) {
        try {
            $data = ConvertFrom-Json -InputObject $content -AsHashtable -NoEnumerate -ErrorAction Stop
        }
        catch {
            Write-Verbose -Message "Response of $Method $($address.GetLeftPart('Path')) is not JSON."
        }
    }
    $code = [int] $response.StatusCode
    $status = if ($code -ge 200 -and $code -lt 300) { 'Ok' }
    elseif ($code -eq 404) { 'Missing' }
    elseif ($code -in @(401, 403)) { 'Forbidden' }
    else { 'Error' }
    $message = ''
    if ($status -ne 'Ok') {
        $reason = if ($data -is [System.Collections.IDictionary] -and $data['error'] -is [System.Collections.IDictionary]) {
            "$($data['error']['code']): $($data['error']['message'])"
        }
        elseif ($data -is [System.Collections.IDictionary] -and $data['message']) { [string] $data['message'] }
        else { $content.Substring(0, [Math]::Min(300, $content.Length)) }
        $message = "HTTP $code from $Method $($address.GetLeftPart('Path')): $reason"
        if ($status -eq 'Forbidden' -and $area -eq 'azure') { $message += " $(Format-SetupAzureTokenDetail -Token $Token)" }
    }
    $headers = @{}
    if ($response.PSObject.Properties['Headers'] -and $null -ne $response.Headers) {
        foreach ($key in @($response.Headers.Keys)) { $headers[[string] $key] = @($response.Headers[$key]) -join ',' }
    }
    return @{ Status = $status; Code = $code; Data = $data; Headers = $headers; Message = $message; Area = $area }
}

function Assert-SetupResponse {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable] $Response,
        [Parameter(Mandatory)][string] $Action,
        [string[]] $Guidance = @(),
        [switch] $AllowMissing
    )

    if ($Response.Status -eq 'Ok') { return , $Response.Data }
    if ($Response.Status -eq 'Missing' -and $AllowMissing) { return $null }
    $lines = @($Guidance)
    if ($Response.Status -eq 'Forbidden' -and $lines.Count -eq 0) {
        if ($Response.Area -eq 'github' -and $Response.Message -match 'organization SAML enforcement') {
            $lines = @(
                'The organization requires SSO authorization for the GitHub CLI OAuth token.',
                'Open the organization in the browser and complete its SSO sign-in, then choose [l] to sign in to GitHub again.',
                'Authorize the OAuth token for this organization. Do not replace it with a PAT or change Azure roles.'
            )
        }
        else {
            $lines = @('The signed-in account lacks the required role or token scope. Activate the role in PIM if needed, then choose [l].')
        }
    }
    Exit-SetupStage -Status $Response.Status -Area $Response.Area -Message "$Action failed. $($Response.Message)" -Guidance $lines
}

function Get-SetupCollection {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string] $Uri,
        [ValidateSet('GET', 'POST')][string] $Method = 'GET',
        [Parameter(Mandatory)][string] $Action,
        [string[]] $Guidance = @()
    )

    $visited = [System.Collections.Generic.HashSet[string]]::new()
    $items = [System.Collections.Generic.List[object]]::new()
    $next = $Uri
    while ($next) {
        if (-not $visited.Add($next)) { Exit-SetupStage -Status Error -Message "$Action returned a pagination cycle." }
        $page = Assert-SetupResponse -Response (Invoke-SetupApi -Setup $Setup -Uri $next -Method $Method) -Action $Action -Guidance $Guidance
        if ($page -isnot [System.Collections.IDictionary] -or $page['value'] -isnot [System.Collections.IList]) {
            Exit-SetupStage -Status Error -Message "$Action did not return a collection."
        }
        foreach ($item in $page['value']) { $items.Add($item) }
        $next = if ($page['@odata.nextLink']) { $page['@odata.nextLink'] } elseif ($page['nextLink']) { $page['nextLink'] } else { $null }
    }
    return $items.ToArray()
}

function Invoke-SetupGraphQL {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable] $Setup,
        [Parameter(Mandatory)][string] $Query,
        [hashtable] $Variables = @{},
        [Parameter(Mandatory)][string] $Action,
        [string[]] $Guidance = @()
    )

    $response = Invoke-SetupApi -Setup $Setup -Uri "https://api.$($Setup.Settings['githubHost'])/graphql" -Method POST -Body @{ query = $Query; variables = $Variables }
    return , (Get-SetupGraphQLData -Response $response -Action $Action -Guidance $Guidance)
}

function Test-SetupGraphQLRejected {
    [CmdletBinding()]
    [OutputType([bool])]
    param([Parameter(Mandatory)][hashtable] $Response)

    # GitHub answered and refused the operation: a client error or GraphQL errors. A lost response never gets here.
    if ($Response.Code -ge 400 -and $Response.Code -lt 500) { return $true }
    return $Response.Status -eq 'Ok' -and $Response.Data -is [System.Collections.IDictionary] -and [bool] $Response.Data['errors']
}

function Get-SetupCreatedOrganization {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Response)

    # GraphQL can return errors next to partial data; any organization in the payload means it may exist.
    $reply = $Response.Data
    if ($reply -isnot [System.Collections.IDictionary] -or $reply['data'] -isnot [System.Collections.IDictionary]) { return $null }
    $result = $reply['data']['createEnterpriseOrganization']
    if ($result -isnot [System.Collections.IDictionary]) { return $null }
    return $result['organization']
}

function Get-SetupGraphQLData {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable] $Response,
        [Parameter(Mandatory)][string] $Action,
        [string[]] $Guidance = @()
    )

    $reply = Assert-SetupResponse -Response $Response -Action $Action -Guidance $Guidance
    if ($reply -isnot [System.Collections.IDictionary]) { Exit-SetupStage -Status Error -Area github -Message "$Action returned no GraphQL data." }
    if ($reply['errors']) {
        $errors = @($reply['errors'])
        $types = @($errors | ForEach-Object { if ($_ -is [System.Collections.IDictionary]) { $_['type'] } })
        $text = @($errors | ForEach-Object { if ($_ -is [System.Collections.IDictionary]) { $_['message'] } else { "$_" } }) -join ' '
        $status = if ('INSUFFICIENT_SCOPES' -in $types -or 'FORBIDDEN' -in $types) { 'Forbidden' }
        elseif ('NOT_FOUND' -in $types) { 'Missing' }
        else { 'Error' }
        Exit-SetupStage -Status $status -Area github -Message "$Action failed: $text" -Guidance $Guidance
    }
    return , $reply['data']
}

function Wait-SetupCondition {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][scriptblock] $Condition,
        [Parameter(Mandatory)][int] $TimeoutSeconds,
        [int] $IntervalSeconds = 10,
        [Parameter(Mandatory)][string] $Activity
    )

    $waitAttempts = [int] [Math]::Ceiling($TimeoutSeconds / $IntervalSeconds)
    for ($waitIndex = 0; $waitIndex -le $waitAttempts; $waitIndex++) {
        $waitResult = & $Condition
        if ($waitResult) {
            Write-Progress -Activity $Activity -Completed
            return , $waitResult
        }
        if ($waitIndex -lt $waitAttempts) {
            $waitElapsed = $waitIndex * $IntervalSeconds
            Write-Progress -Activity $Activity -Status "$waitElapsed of $TimeoutSeconds seconds" -PercentComplete ([Math]::Min(100, [int] (100 * $waitIndex / $waitAttempts)))
            Start-Sleep -Seconds $IntervalSeconds
        }
    }
    Write-Progress -Activity $Activity -Completed
    return $null
}

function Resolve-SetupHostName {
    [CmdletBinding()]
    [OutputType([bool])]
    param([Parameter(Mandatory)][string] $Name)

    try {
        return @([System.Net.Dns]::GetHostAddresses($Name)).Count -gt 0
    }
    catch {
        Write-Verbose -Message "DNS lookup of $Name failed: $($_.Exception.Message)"
        return $false
    }
}

