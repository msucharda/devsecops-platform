    ],
    "[].parameters": [
      "check_response_timeout_minutes",
      "grouping_strategy",
      "max_entries_to_build",
      "max_entries_to_merge",
      "merge_method",
      "min_entries_to_merge",
      "min_entries_to_merge_wait_minutes"
