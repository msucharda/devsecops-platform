function Initialize-SetupContext {
    [CmdletBinding()]
    [OutputType([hashtable])]
    param(
        [Parameter(Mandatory)][string] $RepoPath,
        [Parameter(Mandatory)][string] $WorkPath,
        [Parameter(Mandatory)][string] $ModulesPath,
        [switch] $Reconfirm
    )

    $work = [System.IO.Path]::GetFullPath($WorkPath)
    $repoRoot = [System.IO.Path]::GetFullPath($RepoPath)
    $separator = [System.IO.Path]::DirectorySeparatorChar
    if (($work.TrimEnd($separator) + $separator).StartsWith($repoRoot.TrimEnd($separator) + $separator, [System.StringComparison]::OrdinalIgnoreCase)) {
        throw "The work folder '$work' is inside the source repository. Instance data must stay outside it (ADR 0012)."
    }
    $null = New-Item -ItemType Directory -Force -Path $work
    $statePath = Join-Path $work 'setup-state.json'
    return @{
        RepoPath = $repoRoot
        WorkPath = $work
        ModulesPath = [System.IO.Path]::GetFullPath($ModulesPath)
        Reconfirm = [bool] $Reconfirm
        InstancePath = Join-Path $work 'instance.yaml'
        StatePath = $statePath
        State = Read-SetupState -Path $statePath
        Settings = @{}
        Existing = $null
        Stages = [ordered]@{}
        AzureTokens = @{}
        GitHubToken = $null
        AddedScopes = [System.Collections.Generic.List[string]]::new()
        Facts = @{
            Me = $null; Upn = $null; OwnerRoleId = $null; UserRoleId = $null; OidcModeVerified = $false
            ScimJobId = $null; Login = $null; EnterpriseId = $null; RepositoryPoliciesDisabled = $false; AuthorizationProbePassed = $false
        }
    }
}

function Revoke-SetupGitHubScope {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    if ($Setup.AddedScopes.Count -eq 0) { return }
    $githubHost = $Setup.Settings['githubHost']
    $scopeList = $Setup.AddedScopes -join ','
    $command = "gh auth refresh --hostname $githubHost --remove-scopes $scopeList"
    Show-SetupMessage -Kind Action -Message "The wizard added the temporary gh scopes $scopeList."
    if (-not (Confirm-SetupAction -Prompt 'Remove them now (browser confirmation follows)?' -DefaultYes)) {
        Show-SetupGuidance -Line @("Remove them later: $command")
        return
    }
    & gh auth refresh --hostname $githubHost --remove-scopes $scopeList | Out-Host
    if ($LASTEXITCODE -ne 0) {
        Show-SetupMessage -Kind Warning -Message "gh auth refresh failed. Run: $command"
        return
    }
    $Setup.AddedScopes.Clear()
    $Setup.GitHubToken = $null
}

function Show-SetupSummary {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable] $Setup)

    Show-SetupMessage -Message ''
    Show-SetupMessage -Kind Title -Message '== Summary =='
    Show-SetupTable -Row @($Setup.Stages.Values | Select-Object -Property Step, Title, Status, Detail)
    $open = @($Setup.Stages.Values | Where-Object { $_.Status -ne 'Ok' })
    $notRun = @($script:StagePlan | Where-Object { -not $Setup.Stages.Contains($_.Id) })
    if ($open.Count -eq 0 -and $notRun.Count -eq 0) {
        Show-SetupMessage -Kind Ok -Message "Phase A is complete and preflight passed. Continue with the negative test in step B1 of docs/reference-instance.md, then bootstrap with $($Setup.InstancePath)."
        return
    }
    $first = if ($open.Count -gt 0) { $open[0] } else { $null }
    if ($first) { Show-SetupMessage -Kind Action -Message "Next: fix [$($first.Step)] $($first.Title): $($first.Detail)" }
    Show-SetupMessage -Message 'Run the wizard again after the fix. It checks every step again and continues where it stopped.'
}

function Invoke-InstanceSetup {
    [CmdletBinding()]
    [OutputType([pscustomobject])]
    param(
        [Parameter(Mandatory)][string] $RepoPath,
        [Parameter(Mandatory)][string] $WorkPath,
        [Parameter(Mandatory)][string] $ModulesPath,
        [switch] $GitHubAcceptance,
        [string] $ReleasePath,
        [string] $ReleaseVersion,
        [switch] $Reconfirm
    )

    $setup = Initialize-SetupContext -RepoPath $RepoPath -WorkPath $WorkPath -ModulesPath $ModulesPath -Reconfirm:$Reconfirm
    if ($GitHubAcceptance) {
        return Invoke-SetupGitHubAcceptance -Setup $setup -ReleasePath $ReleasePath -ReleaseVersion $ReleaseVersion
    }
    Show-SetupMessage -Kind Title -Message 'Reference instance setup (phase A of docs/reference-instance.md)'
    Show-SetupMessage -Message 'Every step checks the current state first. The wizard changes nothing without your confirmation.'
    Show-SetupMessage -Message 'Steps without an API show what to do and ask for a confirmation. You can stop at any prompt; the next run resumes.'
    try {
        foreach ($stage in $script:StagePlan) {
            Invoke-SetupStage -Setup $setup -Id $stage.Id -Step $stage.Step -Title $stage.Title -Requires $stage.Requires -Handler "Invoke-Step$($stage.Handler)"
        }
    }
    catch {
        $failure = Get-SetupFailure -ErrorRecord $_
        if (-not $failure.Quit) { throw }
        Show-SetupMessage -Kind Warning -Message $failure.Message
    }
    finally {
        Save-SetupState -Setup $setup
        try {
            Revoke-SetupGitHubScope -Setup $setup
        }
        catch {
            Write-Warning -Message "Removing the temporary gh scopes failed: $($_.Exception.Message)"
        }
    }
    Show-SetupSummary -Setup $setup
    return [pscustomobject]@{
        Stages = @($setup.Stages.Values)
        Flags = Get-SetupFlag -Setup $setup
        InstancePath = $setup.InstancePath
    }
}

#endregion

Export-ModuleMember -Function Invoke-InstanceSetup
