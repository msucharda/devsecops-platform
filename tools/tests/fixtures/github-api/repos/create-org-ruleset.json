{
  "source": {
    "operation": "POST /orgs/{org}/rulesets",
    "operationId": "repos/create-org-ruleset",
    "documentation": "https://docs.github.com/en/enterprise-cloud@latest/rest/orgs/rules#create-an-organization-repository-ruleset",
    "apiVersion": "2026-03-10",
    "description": "https://github.com/github/rest-api-description/blob/bb754941722779d8a5b3a2f25a5fbb7ce794e1ea/descriptions/ghec/ghec.2026-03-10.json",
    "status": 201,
    "schema": "#/components/schemas/repository-ruleset",
    "note": "Documented org-ruleset response example. PUT returns the same repository-ruleset schema. requestProperties and ruleParameters.required/properties are taken from the POST and PUT request schemas at the pinned revision. observedRequestProperties is NOT documented in that schema. The coordinator verified the extra field in successful POST and PUT requests on GHE.com with API 2026-03-10 on 2026-10-27, using the API and deploy run 356209032: one existing ruleset updated in place with this field as the sole body change, two rulesets created, all apply postconditions passed. Subsequent GET in all three organizations returned true for this field, empty bypass_actors and active enforcement. This primary observation supports the request extension required by https://github.com/msucharda/devsecops-platform/issues/122; it does not amend the published schema."
  },
  "required": {
    "": ["id", "name", "source", "enforcement"]
  },
  "requestProperties": ["name", "target", "enforcement", "bypass_actors", "conditions", "rules"],
  "ruleParameters": {
    "pull_request": {
      "required": ["dismiss_stale_reviews_on_push", "require_code_owner_review", "require_last_push_approval", "required_approving_review_count", "required_review_thread_resolution"],
      "properties": ["allowed_merge_methods", "dismiss_stale_reviews_on_push", "dismissal_restriction", "require_code_owner_review", "require_last_push_approval", "required_approving_review_count", "required_review_thread_resolution", "required_reviewers"],
      "observedRequestProperties": ["require_extra_approval_for_unattributed_changes"]
    },
    "code_scanning": {
      "required": ["code_scanning_tools"],
      "properties": ["code_scanning_tools"]
    }
  },
  "body": {
    "id": 21,
    "name": "super cool ruleset",
    "target": "branch",
    "source_type": "Organization",
    "source": "my-org",
    "enforcement": "active",
    "bypass_actors": [{"actor_id": 234, "actor_type": "Team", "bypass_mode": "always"}],
    "conditions": {
      "ref_name": {"include": ["refs/heads/main", "refs/heads/master"], "exclude": ["refs/heads/dev*"]},
      "repository_name": {"include": ["important_repository", "another_important_repository"], "exclude": ["unimportant_repository"], "protected": true}
    },
    "rules": [{"type": "commit_author_email_pattern", "parameters": {"operator": "contains", "pattern": "github"}}],
    "node_id": "RRS_lACkVXNlcgQB",
    "_links": {
      "self": {"href": "https://api.github.com/orgs/my-org/rulesets/21"},
      "html": {"href": "https://github.com/organizations/my-org/settings/rules/21"}
    },
    "created_at": "2023-08-15T08:43:03Z",
    "updated_at": "2023-09-23T16:29:47Z"
  }
}
